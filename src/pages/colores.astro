            <div id="foto-dominantes" class="mt-2 flex flex-wrap gap-2"></div>
          </div>

          <div id="foto-objetivo" class="mt-5 flex items-center gap-3 rounded-xl bg-crema-100 p-3"></div>

          <label class="mt-5 block text-sm">
            <span class="font-semibold text-tinta-700">La luz de tu foto</span>
            <input id="foto-luz" type="range" min="-20" max="20" step="1" value="0" class="mt-2 w-full accent-brand-500" />
            <span class="mt-1 flex justify-between text-xs text-tinta-500"><span>Salió muy oscura</span><span>Salió muy clara</span></span>
          </label>

          <h3 class="mt-7 font-display text-xl font-bold text-tinta-900">Los más parecidos del abanico</h3>
          <div id="foto-resultado" class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4"></div>

