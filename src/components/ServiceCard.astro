---
interface Props {
  title: string;
  description: string;
  color: string; // clase Tailwind de fondo, ej. "bg-cielo-500"
  textColor?: string;
  icon: "swatch" | "mix" | "advice" | "truck";
}
const { title, description, color, textColor = "text-crema-50", icon } = Astro.props;

const icons: Record<Props["icon"], string> = {
  swatch:
    'M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z',
  mix: 'M12 3v4M6 7h12l-1.5 12a2 2 0 0 1-2 1.8h-5a2 2 0 0 1-2-1.8L6 7Z',
  advice:
    'M12 19v2M12 3a6 6 0 0 0-4 10.5c.6.55 1 1.3 1 2.1V17h6v-1.4c0-.8.4-1.55 1-2.1A6 6 0 0 0 12 3Z',
  truck:
    'M3 7h11v9H3V7Zm11 4h4l3 3v2h-7v-5ZM6.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm11 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z',
};
---

<article class="blob-corner-alt flex flex-col gap-5 border border-tinta-900/5 bg-crema-50 p-7 shadow-sm transition-all hover:-translate-y-1.5 hover:shadow-xl sm:flex-row sm:items-start">
  <div class={`grid h-14 w-14 shrink-0 place-items-center rounded-2xl ${color} ${textColor}`}>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d={icons[icon]} />
    </svg>
  </div>
  <div>
    <h3 class="font-display text-lg font-bold text-tinta-900">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-tinta-500">{description}</p>
  </div>
</article>
