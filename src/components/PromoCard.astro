---
interface Props {
  badge: string;
  title: string;
  description: string;
  detail: string;
  gradient: string;
  tilt?: "left" | "right" | "none";
}
const { badge, title, description, detail, gradient, tilt = "none" } = Astro.props;
const rotation = tilt === "left" ? "sm:-rotate-1" : tilt === "right" ? "sm:rotate-1" : "";
---

<article class={`group relative overflow-hidden rounded-[2rem] border border-tinta-900/5 bg-crema-50 shadow-sm transition-all hover:-translate-y-1.5 hover:shadow-xl ${rotation}`}>
  <div class={`flex items-center justify-between px-6 py-5 ${gradient}`}>
    <span class="rounded-full bg-crema-50/95 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wide text-tinta-900">
      {badge}
    </span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-crema-50/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L4 3l.24 5.59a2 2 0 0 0 .58 1.41l9.59 9.59a2 2 0 0 0 2.83 0l3.34-3.34a2 2 0 0 0 0-2.83Z" />
      <circle cx="7.5" cy="7.5" r="1.2" fill="currentColor" stroke="none" />
    </svg>
  </div>
  <div class="p-6">
    <h3 class="font-display text-xl font-bold text-tinta-900">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-tinta-500">{description}</p>
    <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-brand-600">{detail}</p>
  </div>
</article>
