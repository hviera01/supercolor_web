---
interface Props {
  title: string;
  subtitle: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title,
  subtitle,
  primaryLabel = "Visítanos hoy",
  primaryHref = "/ubicacion",
  secondaryLabel = "Escríbenos",
  secondaryHref = "/contacto",
} = Astro.props;
---

<section class="relative overflow-hidden bg-tinta-900">
  <div class="pointer-events-none absolute -left-16 -top-16 h-56 w-56 rounded-full bg-brand-500/30 blur-2xl"></div>
  <div class="pointer-events-none absolute -bottom-20 -right-10 h-64 w-64 rounded-full bg-sol-500/20 blur-2xl"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-1/3 skew-x-[-10deg] bg-brand-500/90 sm:block"></div>

  <div class="relative mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-xl">
      <h2 class="font-display text-3xl font-bold text-crema-50 sm:text-4xl">{title}</h2>
      <p class="mt-4 text-base leading-relaxed text-crema-100/75">{subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={primaryHref}
          class="rounded-full bg-brand-500 px-6 py-3.5 text-sm font-bold text-crema-50 shadow-lg shadow-brand-500/30 transition-transform hover:-translate-y-0.5 hover:bg-brand-400"
        >
          {primaryLabel}
        </a>
        <a
          href={secondaryHref}
          class="rounded-full border-2 border-crema-50/30 px-6 py-3.5 text-sm font-bold text-crema-50 transition-colors hover:border-crema-50 hover:bg-crema-50/10"
        >
          {secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
