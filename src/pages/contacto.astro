---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionKicker from "../components/SectionKicker.astro";

const canales = [
  { label: "Teléfono", value: "+504 2220-1144", color: "bg-brand-500" },
  { label: "WhatsApp", value: "+504 9988-7766", color: "bg-menta-500" },
  { label: "Correo", value: "ventas@supercolorhn.com", color: "bg-cielo-500" },
  { label: "Horario", value: "Lun–Sáb: 8:00 am – 6:00 pm", color: "bg-mandarina-500" },
];
---

<BaseLayout title="Contacto" description="Escríbenos, llámanos o visítanos. Súper Color está para ayudarte a encontrar tu color.">
  <section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-64 bg-gradient-to-br from-crema-200 to-crema-100"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-6 pt-16 text-center sm:px-8 sm:pt-20">
      <SectionKicker text="Hablemos" dot="bg-fiesta-500" />
      <h1 class="mt-6 font-display text-4xl font-bold text-tinta-900 sm:text-5xl">
        Cuéntanos qué color estás buscando
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-tinta-500">
        Escríbenos con tu duda, envía una foto de tu muestra o pide una
        cotización. Te respondemos el mismo día.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <form class="blob-corner border border-tinta-900/5 bg-crema-50 p-7 shadow-sm sm:p-9">
        <h2 class="font-display text-2xl font-bold text-tinta-900">Envíanos un mensaje</h2>
        <p class="mt-2 text-sm text-tinta-500">
          Este formulario es de muestra — pronto quedará conectado para enviar
          tu mensaje directamente a nuestro equipo.
        </p>

        <div class="mt-7 grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-semibold text-tinta-700">
            Nombre completo
            <input
              type="text"
              name="nombre"
              placeholder="Tu nombre"
              class="mt-2 w-full rounded-xl border border-tinta-900/10 bg-crema-100 px-4 py-3 text-sm text-tinta-900 outline-none placeholder:text-tinta-500/60 focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
            />
          </label>
          <label class="block text-sm font-semibold text-tinta-700">
            Teléfono
            <input
              type="tel"
              name="telefono"
              placeholder="+504 0000-0000"
              class="mt-2 w-full rounded-xl border border-tinta-900/10 bg-crema-100 px-4 py-3 text-sm text-tinta-900 outline-none placeholder:text-tinta-500/60 focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
            />
          </label>
        </div>

        <label class="mt-5 block text-sm font-semibold text-tinta-700">
          Correo electrónico
          <input
            type="email"
            name="email"
            placeholder="tucorreo@ejemplo.com"
            class="mt-2 w-full rounded-xl border border-tinta-900/10 bg-crema-100 px-4 py-3 text-sm text-tinta-900 outline-none placeholder:text-tinta-500/60 focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
          />
        </label>

        <label class="mt-5 block text-sm font-semibold text-tinta-700">
          Mensaje
          <textarea
            name="mensaje"
            rows="5"
            placeholder="Cuéntanos sobre tu proyecto o el color que buscas..."
            class="mt-2 w-full resize-none rounded-xl border border-tinta-900/10 bg-crema-100 px-4 py-3 text-sm text-tinta-900 outline-none placeholder:text-tinta-500/60 focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
          ></textarea>
        </label>

        <button
          type="button"
          class="mt-7 w-full rounded-full bg-brand-500 px-6 py-4 text-sm font-bold text-crema-50 shadow-lg shadow-brand-500/30 transition-transform hover:-translate-y-0.5 hover:bg-brand-600 sm:w-auto"
        >
          Enviar mensaje
        </button>
      </form>

      <div class="space-y-4">
        {canales.map((c) => (
          <div class="flex items-center gap-4 rounded-2xl border border-tinta-900/5 bg-crema-50 p-5 shadow-sm">
            <span class={`h-11 w-11 shrink-0 rounded-full ${c.color}`}></span>
            <div>
              <p class="text-xs font-bold uppercase tracking-wide text-tinta-500">{c.label}</p>
              <p class="font-display text-lg font-bold text-tinta-900">{c.value}</p>
            </div>
          </div>
        ))}

        <div class="rounded-2xl bg-tinta-900 p-6 text-crema-50">
          <h3 class="font-display text-lg font-bold">¿Prefieres visitarnos?</h3>
          <p class="mt-2 text-sm text-crema-100/75">
            Tenemos dos sucursales en Tegucigalpa listas para atenderte.
          </p>
          <a href="/sucursales" class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-sol-400 hover:text-sol-300">
            Ver ubicaciones y horarios
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
