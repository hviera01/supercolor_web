---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionKicker from "../components/SectionKicker.astro";
import CTABand from "../components/CTABand.astro";
---

<BaseLayout title="Productos" description="Catálogo de pinturas látex, aceite, anticorrosivos, impermeabilizantes y accesorios de Súper Color.">
  <section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-64 bg-gradient-to-br from-crema-200 to-crema-100"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-6 pt-16 text-center sm:px-8 sm:pt-20">
      <SectionKicker text="Catálogo completo" dot="bg-brand-500" />
      <h1 class="mt-6 font-display text-4xl font-bold text-tinta-900 sm:text-5xl">
        Todo lo que necesitas para pintar bien
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-tinta-500">
        Cinco categorías, un mismo estándar de calidad. Si no ves el color que
        buscas, lo igualamos a mano frente a ti.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">
    <div id="productos-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
  </section>

  <!-- MATE VS SATINADA -->
  <section class="bg-crema-200/60 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <SectionKicker text="Guía rápida" dot="bg-cielo-500" />
      <h2 class="mt-4 font-display text-3xl font-bold text-tinta-900 sm:text-4xl">
        ¿Mate o satinada? Cuál conviene más
      </h2>
      <p class="mt-4 max-w-2xl text-tinta-600">
        Las dos se ven bien, pero no rinden igual. Esto es lo que notamos
        después de años vendiendo ambas:
      </p>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="blob-corner border border-tinta-900/5 bg-crema-50 p-7 shadow-sm">
          <span class="inline-block h-3 w-10 rounded-full bg-tinta-500"></span>
          <h3 class="mt-4 font-display text-xl font-bold text-tinta-900">Mate</h3>
          <p class="mt-2 text-sm leading-relaxed text-tinta-500">
            Acabado sin brillo, disimula mejor las imperfecciones de la pared.
            Buena opción para techos y para cuartos o salas de poco tránsito,
            donde no se ensucia ni se golpea tanto.
          </p>
        </div>

        <div class="blob-corner-alt relative border-2 border-brand-500 bg-crema-50 p-7 shadow-md">
          <span class="absolute right-5 top-5 rounded-full bg-brand-500 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-crema-50">
            Recomendada
          </span>
          <span class="inline-block h-3 w-10 rounded-full bg-brand-500"></span>
          <h3 class="mt-4 font-display text-xl font-bold text-tinta-900">Satinada</h3>
          <p class="mt-2 text-sm leading-relaxed text-tinta-500">
            Tiene un poco más de brillo y es mucho más lavable: la suciedad se
            desliza en vez de pegarse, y aguanta mejor el polvo, el agua y el
            sol. Por eso la recomendamos para exteriores, cocinas, baños y
            cualquier zona de mucho uso.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    title="¿No encontraste el color exacto?"
    subtitle="Nuestro servicio de igualación de color existe justo para eso. Trae tu muestra y lo resolvemos en minutos."
    primaryLabel="Escríbenos por WhatsApp"
    primaryHref="/contacto"
    primaryWhatsapp
    primaryWhatsappMensaje="Hola, no encontré el color exacto que buscaba en el catálogo, ¿me pueden ayudar?"
    secondaryLabel="Ver servicio de igualación"
    secondaryHref="/servicios"
  />
</BaseLayout>

<script>
  import { fetchProductosDestacados, type ProductoDestacado } from "../lib/content";
  import { abrirModalProducto } from "../lib/product-modal";
  import {
    colorPorIndice,
    degradadoPorIndice,
    escapeHtml,
    esqueletoTarjetas,
    estadoErrorHtml,
    estadoVacioHtml,
    paintCanHtml,
  } from "../lib/render-utils";

  const contenedor = document.getElementById("productos-list");
  // Se guarda la última lista cargada para poder recuperar el producto completo
  // (incluida su disponibilidad) al hacer click en una tarjeta.
  let productosCargados: ProductoDestacado[] = [];

  function tarjetaHtml(p: ProductoDestacado, indice: number): string {
    const tieneFoto = Boolean(p.imagenUrl);
    const nombre = p.nombre || "Producto Súper Color";

    // La insignia de categoría se pinta DESPUÉS de la foto en el DOM (y con z-10)
    // para que siempre quede encima de la imagen del producto, nunca tapada por ella.
    const etiqueta = p.categoria
      ? `<span class="absolute right-3 top-3 z-10 rounded-full bg-crema-50 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-tinta-900 shadow-md">${escapeHtml(p.categoria)}</span>`
      : "";

    const disponibilidad = p.disponibilidad
      ? `<p class="mt-3 rounded-xl bg-menta-300/15 px-3 py-2 text-xs font-semibold leading-relaxed text-menta-700">${escapeHtml(p.disponibilidad)}</p>`
      : "";

    // Fondo blanco/crema limpio para fotos reales (los botes ya traen su propio color
    // de etiqueta); el degradado de marca se reserva para la lata ilustrada de respaldo.
    const cabecera = tieneFoto
      ? `<img src="${escapeHtml(p.imagenUrl!)}" alt="${escapeHtml(nombre)}" class="max-h-full max-w-full object-contain" />`
      : `<div class="absolute -left-6 -top-6 h-24 w-24 rounded-full bg-white/10"></div>
         <div class="absolute -right-4 top-8 h-14 w-14 rounded-full bg-white/10"></div>
         ${paintCanHtml(colorPorIndice(indice))}`;

    const clasesCabecera = tieneFoto
      ? "relative flex h-40 items-center justify-center overflow-hidden bg-crema-100 p-6"
      : `relative flex h-40 items-end justify-center overflow-hidden ${degradadoPorIndice(indice)} pt-6`;

    return `
      <button
        type="button"
        data-indice="${indice}"
        class="group blob-corner block w-full overflow-hidden border border-tinta-900/5 bg-crema-50 text-left shadow-sm transition-all hover:-translate-y-1.5 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
      >
        <div class="${clasesCabecera}">
          ${cabecera}
          ${etiqueta}
        </div>
        <div class="p-6">
          <h3 class="font-display text-xl font-bold text-tinta-900">${escapeHtml(nombre)}</h3>
          <p class="mt-2 text-sm leading-relaxed text-tinta-500">${escapeHtml(p.descripcion || "")}</p>
          ${disponibilidad}
        </div>
      </button>`;
  }

  contenedor?.addEventListener("click", (e) => {
    const boton = (e.target as HTMLElement).closest("button[data-indice]") as HTMLButtonElement | null;
    if (!boton || !contenedor.contains(boton)) return;
    const producto = productosCargados[Number(boton.dataset.indice)];
    if (!producto) return;
    abrirModalProducto(
      {
        nombre: producto.nombre || "Producto Súper Color",
        descripcion: producto.descripcion,
        categoria: producto.categoria,
        disponibilidad: producto.disponibilidad,
        imagenUrl: producto.imagenUrl,
        indiceColor: Number(boton.dataset.indice),
      },
      boton,
    );
  });

  (async () => {
    if (!contenedor) return;
    contenedor.innerHTML = esqueletoTarjetas(3, "h-64");
    const { data, error } = await fetchProductosDestacados();
    if (error) {
      contenedor.innerHTML = estadoErrorHtml();
      return;
    }
    if (data.length === 0) {
      contenedor.innerHTML = estadoVacioHtml("Pronto vas a ver aquí nuestro catálogo destacado.");
      return;
    }
    productosCargados = data;
    contenedor.innerHTML = data.map((p, i) => tarjetaHtml(p, i)).join("");
  })();
</script>
