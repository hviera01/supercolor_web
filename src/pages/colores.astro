</style>

<script>
  import datosColores from "../data/lanco_colores.json";
  import {
    enriquecerColores,
    textoSobre,
    ETIQUETAS_FAMILIA,
    ORDEN_FAMILIAS,
    combinador,
    AREAS,
    OBJETIVOS,
    type ColorLanco,
    type ColorEnriquecido,
    type FamiliaColor,
    type ObjetivoCombinacion,
  } from "../lib/color-lanco";
  import { abrirModalColor } from "../lib/color-modal";
  import {
    ajustarLuz,
    colorDeZona,
    coloresDominantes,
    etiquetaSimilitud,
    indexarAbanico,
    parecidosEnAbanico,
    rgbAHex,
    rgbALab,
    type Rgb,
  } from "../lib/color-foto";
  import {
    alCambiarApartados,
    alternarApartado,
    apartados,
    estaApartado,
    quitarApartado,
    vaciarApartados,
  } from "../lib/colores-apartados";
  import { iniciarProbador } from "../lib/probador";
  import { escenaFachada, escenaSala } from "../lib/vista-combinacion";
  import { fetchConfiguracion } from "../lib/content";
  import { enlaceWhatsapp } from "../lib/site-chrome";
  import { escapeHtml } from "../lib/render-utils";
  import {
    areaDesdeAnchoAlto,
    areaDesdeLineal,
    calcularPintura,
    TIPOS_PRODUCTO,
    type TipoProducto,
  } from "../lib/rendimiento";

  const paleta: ColorEnriquecido[] = enriquecerColores(datosColores as ColorLanco[]);
  const porCodigo = new Map(paleta.map((c) => [c.codigo, c]));
  const probador = iniciarProbador(paleta, porCodigo);
  const claveDe = new Map<string, string>();

  const contador = document.getElementById("colores-contador") as HTMLElement;
  const inputBuscar = document.getElementById("colores-buscar") as HTMLInputElement;
  const sugerencias = document.getElementById("colores-sugerencias") as HTMLElement;
  const chips = document.getElementById("colores-chips") as HTMLElement;
  const botonesVista = document.querySelectorAll<HTMLButtonElement>("[data-vista]");
  const vistaAbanico = document.getElementById("vista-abanico") as HTMLElement;
  const vistaFamilias = document.getElementById("vista-familias") as HTMLElement;
  const secciones = document.getElementById("colores-secciones") as HTMLElement;
  const vacio = document.getElementById("colores-vacio") as HTMLElement;

  type Vista = "abanico" | "familias";
  let vista: Vista = "abanico";
  try {
    if (localStorage.getItem("sc-colores-vista") === "familias") vista = "familias";
  } catch {}
  let familiaFiltro: FamiliaColor | "" = "";

  /** Codigo o texto sin guiones, espacios ni mayusculas: "3g1 5", "3G1-5" y "3g15" son lo mismo. */
  const clave = (texto: string): string => normalizar(texto).replace(/[^a-z0-9]/g, "");
  function normalizar(texto: string): string {
    return texto
      .toLowerCase()
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "");
  }

  paleta.forEach((c) => claveDe.set(c.codigo, clave(c.codigo)));
  function coincideBusqueda(c: ColorEnriquecido, texto: string, k: string): boolean {
    return normalizar(c.nombre).includes(texto) || (k !== "" && (claveDe.get(c.codigo) ?? "").includes(k));
  }

  const ICONO_CORAZON =
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 7.9 3.5 5 6.6 5c1.9 0 3.5 1 4.4 2.5h2C13.9 6 15.5 5 17.4 5c3.1 0 5.2 2.9 3.9 6.3-1.8 4.6-9.3 9.2-9.3 9.2z"/></svg>';

  function corazonHtml(c: ColorEnriquecido, extra = ""): string {
    const ap = estaApartado(c.codigo);
    return `<button type="button" data-apartar="${escapeHtml(c.codigo)}" class="corazon-btn ${extra}" aria-pressed="${ap}" aria-label="Apartar ${escapeHtml(c.nombre)}" title="${ap ? "Quitar de mi selección" : "Apartar este color"}">${ICONO_CORAZON}</button>`;
  }

  function colorRepresentativo(familia: FamiliaColor): string {
    const grupo = paleta.filter((c) => c.familia === familia).sort((a, b) => b.l - a.l);
    return grupo.length ? grupo[Math.floor(grupo.length * 0.4)].hex : "#cccccc";
  }

  // ======================================================================
  // ABANICO: cada página es una tira de colores (3G1-1, 3G1-2, ...), igual
  // que el abanico físico. Se pasa de una en una, deslizando, con las
  // flechas, o saltando con la barra de espectro.
  // ======================================================================
  interface Franja {
    prefijo: string;
    colores: ColorEnriquecido[];
  }

  const prefijoDe = (c: ColorEnriquecido): string => c.codigo.replace(/-\d+$/, "");
  const numeroDe = (c: ColorEnriquecido): number => Number(c.codigo.match(/-(\d+)$/)?.[1] ?? 0);
  const familiasSinMatiz = new Set<FamiliaColor>(["blancos", "cremas_beiges", "neutros"]);
  const posicionFamilia = new Map(ORDEN_FAMILIAS.map((f, i) => [f, i]));
  const colorMedio = (f: Franja): ColorEnriquecido => f.colores[Math.floor(f.colores.length / 2)];

  /** Agrupa por código (3G1-1..3G1-8 = una tira) y ordena las tiras como un
   * espectro: blancos y neutros primero, luego por matiz -así páginas
   * vecinas se parecen y pasar de una a otra se siente continuo. */
  function construirFranjas(colores: ColorEnriquecido[]): Franja[] {
    const grupos = new Map<string, ColorEnriquecido[]>();
    for (const c of colores) {
      const k = prefijoDe(c);
      if (!grupos.has(k)) grupos.set(k, []);
      grupos.get(k)!.push(c);
    }
    const lista: Franja[] = [...grupos].map(([prefijo, cs]) => ({
      prefijo,
      colores: cs.sort((a, b) => numeroDe(a) - numeroDe(b)),
    }));
    return lista.sort((a, b) => {
      const ra = colorMedio(a);
      const rb = colorMedio(b);
      const fa = posicionFamilia.get(ra.familia) ?? 0;
      const fb = posicionFamilia.get(rb.familia) ?? 0;
      if (fa !== fb) return fa - fb;
      if (familiasSinMatiz.has(ra.familia)) return rb.l - ra.l;
      return ra.h - rb.h || rb.l - ra.l;
    });
  }

  // El abanico es un carrusel NATIVO (desplazamiento horizontal con imán por
  // página): el propio teléfono se encarga del deslizar, así que responde
  // igual con deslizamientos lentos, rápidos o en diagonal, y el scroll
  // vertical de la página nunca se traba. Las tarjetas se inclinan según
  // su distancia al centro para dar el efecto de abanico.
  const escenario = document.getElementById("abanico-escenario") as HTMLElement;
  const pista = document.getElementById("abanico-cartas") as HTMLElement;
  const botonesNav = document.querySelectorAll<HTMLButtonElement>("[data-nav]");
  const paginaActual = document.getElementById("abanico-pagina-actual") as HTMLElement;
  const paginaTotal = document.getElementById("abanico-pagina-total") as HTMLElement;
  const espectro = document.getElementById("abanico-espectro") as HTMLElement;
  const barraEspectro = document.getElementById("abanico-barra") as HTMLElement;
  const manija = document.getElementById("abanico-manija") as HTMLElement;

  let franjas: Franja[] = [];
  let indice = 0;
  let abierto: string | null = null;
  let objetivo: number | null = null;
  let temporizadorObjetivo: ReturnType<typeof setTimeout> | undefined;
  let ventana = new Set<number>();

  function cartaHtml(i: number): string {
    const f = franjas[i];
    const colores = f.colores
      .map(
        (c) => `
        <div class="franja-color" data-codigo-franja="${escapeHtml(c.codigo)}" data-abierto="${c.codigo === abierto}" style="background:${c.hex};color:${textoSobre(c.hex)}">
          <button type="button" class="franja-abrir" data-abrir="${escapeHtml(c.codigo)}" aria-expanded="${c.codigo === abierto}" aria-label="${escapeHtml(c.nombre)}, ${escapeHtml(c.codigo)}. Tocá para verlo en grande"></button>
          ${corazonHtml(c, "franja-corazon")}
          <div class="franja-texto">
            <div class="franja-codigo">${escapeHtml(c.codigo)}</div>
            <div class="franja-nombre">${escapeHtml(c.nombre)}</div>
          </div>
          <div class="franja-acciones">
            <button type="button" data-combinar="${escapeHtml(c.codigo)}">Ideas para combinarlo</button>
            <button type="button" data-probar="${escapeHtml(c.codigo)}">Probarlo en una foto</button>
            <button type="button" data-grande="${escapeHtml(c.codigo)}">Ver en pantalla completa</button>
          </div>
        </div>`,
      )
      .join("");
    return `<div class="franja-lista">${colores}</div><div class="franja-pie"><span>${escapeHtml(f.prefijo)}</span><span>${i + 1}</span></div>`;
  }

  const slideDe = (i: number): HTMLElement | null => (pista.children[i] as HTMLElement | undefined) ?? null;
  const cartaDe = (i: number): HTMLElement | null => (slideDe(i)?.firstElementChild as HTMLElement | null) ?? null;

  /** Las tarjetas se llenan solo cuando están cerca: así hay 255 páginas
   * disponibles sin cargar miles de elementos de golpe. */
  function llenar(i: number): void {
    const slide = slideDe(i);
    const carta = cartaDe(i);
    if (!slide || !carta || slide.dataset.listo) return;
    slide.dataset.listo = "1";
    carta.innerHTML = cartaHtml(i);
  }

  function pasoPagina(): number {
    const a = pista.children[0] as HTMLElement | undefined;
    const b = pista.children[1] as HTMLElement | undefined;
    if (!a) return 0;
    return b ? b.offsetLeft - a.offsetLeft : a.offsetWidth;
  }

  function aplicarAbierto(): void {
    pista.querySelectorAll<HTMLElement>(".franja-color").forEach((el) => {
      const esAbierto = el.dataset.codigoFranja === abierto;
      el.dataset.abierto = String(esAbierto);
      el.querySelector(".franja-abrir")?.setAttribute("aria-expanded", String(esAbierto));
    });
  }

  function actualizarPie(): void {
    const n = franjas.length;
    paginaActual.textContent = String(n ? indice + 1 : 0);
    paginaTotal.textContent = String(n);
    espectro.setAttribute("aria-valuenow", String(indice + 1));
    espectro.setAttribute("aria-valuemax", String(Math.max(1, n)));
    if (n) {
      manija.style.left = `${((indice + 0.5) / n) * 100}%`;
      manija.style.background = colorMedio(franjas[indice]).hex;
    }
    botonesNav.forEach((b) => {
      b.disabled = b.dataset.nav === "ant" ? indice <= 0 : indice >= n - 1;
    });
  }

  /** Se ejecuta mientras se desplaza: calcula la página actual, llena las
   * tarjetas cercanas e inclina las vecinas como un abanico. */
  function ajustarAbanico(): void {
    const n = franjas.length;
    const paso = pasoPagina();
    if (!n || paso <= 0) return;
    const pos = pista.scrollLeft / paso;

    let nuevo = objetivo ?? Math.max(0, Math.min(n - 1, Math.round(pos)));
    if (objetivo !== null && Math.abs(pos - objetivo) < 0.03) objetivo = null;
    if (nuevo !== indice) {
      indice = nuevo;
      if (abierto && !franjas[indice].colores.some((c) => c.codigo === abierto)) {
        abierto = null;
        aplicarAbierto();
      }
      actualizarPie();
    }

    for (let i = Math.max(0, indice - 3); i <= Math.min(n - 1, indice + 4); i++) llenar(i);

    const nueva = new Set<number>();
    for (let i = Math.max(0, Math.floor(pos) - 2); i <= Math.min(n - 1, Math.ceil(pos) + 3); i++) {
      nueva.add(i);
      const carta = cartaDe(i);
      if (!carta) continue;
      const o = i - pos;
      const ao = Math.min(Math.abs(o), 2);
      const giro = Math.max(-8, Math.min(8, o * 2.8));
      carta.style.transform = `translateY(${(ao * 8).toFixed(1)}px) rotate(${giro.toFixed(2)}deg) scale(${(1 - ao * 0.04).toFixed(3)})`;
    }
    for (const i of ventana) {
      if (!nueva.has(i)) {
        const carta = cartaDe(i);
        if (carta) carta.style.transform = "";
      }
    }
    ventana = nueva;
  }

  function ir(destino: number, instantaneo = false): void {
    const n = franjas.length;
    if (!n) return;
    const nuevo = Math.max(0, Math.min(n - 1, destino));
    for (let i = Math.max(0, nuevo - 3); i <= Math.min(n - 1, nuevo + 4); i++) llenar(i);
    if (nuevo !== indice) {
      indice = nuevo;
      abierto = null;
      aplicarAbierto();
      actualizarPie();
    }
    objetivo = nuevo;
    clearTimeout(temporizadorObjetivo);
    temporizadorObjetivo = setTimeout(() => {
      objetivo = null;
      ajustarAbanico();
    }, 900);
    pista.scrollTo({ left: nuevo * pasoPagina(), behavior: instantaneo ? "auto" : "smooth" });
    if (instantaneo) ajustarAbanico();
  }

  function pintarEspectro(): void {
    const n = franjas.length;
    const tramos = franjas.map((f, i) => `${colorMedio(f).hex} ${((i / n) * 100).toFixed(3)}% ${(((i + 1) / n) * 100).toFixed(3)}%`);
    barraEspectro.style.background = `linear-gradient(to right, ${tramos.join(",")})`;
  }

  function reconstruirAbanico(): void {
    const base = familiaFiltro ? paleta.filter((c) => c.familia === familiaFiltro) : paleta;
    franjas = construirFranjas(base);
    pista.innerHTML = franjas
      .map((_, i) => `<div class="abanico-slide" data-i="${i}"><div class="abanico-carta"></div></div>`)
      .join("");
    ventana = new Set();
    indice = 0;
    abierto = null;
    objetivo = null;
    pista.scrollTo({ left: 0, behavior: "auto" });
    pintarEspectro();
    for (let i = 0; i < Math.min(franjas.length, 5); i++) llenar(i);
    ajustarAbanico();
    actualizarPie();
    contador.textContent = `${base.length} colores · ${franjas.length} páginas`;
  }

  let cuadroPendiente = false;
  pista.addEventListener(
    "scroll",
    () => {
      if (cuadroPendiente) return;
      cuadroPendiente = true;
      requestAnimationFrame(() => {
        cuadroPendiente = false;
        ajustarAbanico();
      });
    },
    { passive: true },
  );
  const soltarObjetivo = () => {
    objetivo = null;
  };
  pista.addEventListener("pointerdown", soltarObjetivo, { passive: true });

  // Ayuda para que deslizar sea siempre cómodo: el carrusel nativo solo pasa
  // de página si se arrastra más de la mitad (o con mucho impulso). Aquí, un
  // deslizamiento horizontal claro -aunque sea corto o lento- avanza una
  // página. No usa preventDefault, así el scroll vertical queda intacto.
  let toque: { x: number; y: number; pagina: number } | null = null;
  pista.addEventListener(
    "touchstart",
    (e) => {
      soltarObjetivo();
      if (e.touches.length !== 1) {
        toque = null;
        return;
      }
      toque = { x: e.touches[0].clientX, y: e.touches[0].clientY, pagina: indice };
    },
    { passive: true },
  );
  pista.addEventListener(
    "touchend",
    (e) => {
      const inicio = toque;
      toque = null;
      if (!inicio || !e.changedTouches.length) return;
      const dx = e.changedTouches[0].clientX - inicio.x;
      const dy = e.changedTouches[0].clientY - inicio.y;
      if (Math.abs(dx) > 28 && Math.abs(dx) > Math.abs(dy) * 1.2) {
        ir(inicio.pagina + (dx < 0 ? 1 : -1));
      }
    },
    { passive: true },
  );
  pista.addEventListener("touchcancel", () => (toque = null), { passive: true });
  window.addEventListener("resize", () => {
    if (franjas.length) pista.scrollTo({ left: indice * pasoPagina(), behavior: "auto" });
  });

  botonesNav.forEach((b) =>
    b.addEventListener("click", () => ir((objetivo ?? indice) + (b.dataset.nav === "sig" ? 1 : -1))),
  );

  document.addEventListener("keydown", (e) => {
    if (vista !== "abanico" || (e.key !== "ArrowLeft" && e.key !== "ArrowRight")) return;
    if (["INPUT", "SELECT", "TEXTAREA"].includes((e.target as HTMLElement).tagName)) return;
    const modalColor = document.getElementById("modal-color");
    if (modalColor && !modalColor.classList.contains("hidden")) return;
    if (!apartadosPanel.classList.contains("hidden")) return;
    e.preventDefault();
    ir((objetivo ?? indice) + (e.key === "ArrowRight" ? 1 : -1));
  });

  // ---------- Barra de espectro: tocar o arrastrar para saltar de página ----------
  let barraGesto: { id: number; x: number; y: number; activo: boolean; tactil: boolean } | null = null;
  function indiceDesdeX(x: number): number {
    const r = barraEspectro.getBoundingClientRect();
    const t = (x - r.left) / r.width;
    return Math.max(0, Math.min(franjas.length - 1, Math.floor(t * franjas.length)));
  }
  function activarBarra(e: PointerEvent): void {
    if (!barraGesto) return;
    barraGesto.activo = true;
    try {
      espectro.setPointerCapture(e.pointerId);
    } catch {}
  }
  // Con el dedo, la barra deja pasar el scroll vertical de la página: solo
  // reacciona a un toque o a un arrastre horizontal. Con el mouse, salta al instante.
  espectro.addEventListener("pointerdown", (e) => {
    const tactil = e.pointerType !== "mouse";
    barraGesto = { id: e.pointerId, x: e.clientX, y: e.clientY, activo: false, tactil };
    if (!tactil) {
      activarBarra(e);
      ir(indiceDesdeX(e.clientX), true);
    }
  });
  espectro.addEventListener("pointermove", (e) => {
    if (!barraGesto || e.pointerId !== barraGesto.id) return;
    if (!barraGesto.activo) {
      const dx = e.clientX - barraGesto.x;
      const dy = e.clientY - barraGesto.y;
      if (Math.abs(dx) > 6 && Math.abs(dx) > Math.abs(dy)) activarBarra(e);
      else return;
    }
    ir(indiceDesdeX(e.clientX), true);
  });
  espectro.addEventListener("pointerup", (e) => {
    if (barraGesto && !barraGesto.activo && barraGesto.tactil && e.pointerId === barraGesto.id) {
      ir(indiceDesdeX(e.clientX), true);
    }
    barraGesto = null;
  });
  espectro.addEventListener("pointercancel", () => {
    barraGesto = null;
  });

  // ---------- Tocar un color: se agranda dentro de la tira ----------
  function alMostrarEnAbanico(c: ColorEnriquecido): void {
    const idx = franjas.findIndex((f) => f.prefijo === prefijoDe(c));
    if (idx < 0) return;
    ir(idx, true);
    abierto = c.codigo;
    aplicarAbierto();
  }

  pista.addEventListener("click", (e) => {
    const destino = e.target as HTMLElement;
    const corazon = destino.closest("button[data-apartar]") as HTMLButtonElement | null;
    if (corazon) {
      alternarApartado(corazon.dataset.apartar!);
      return;
    }
    const abrir = destino.closest("button[data-abrir]") as HTMLButtonElement | null;
    if (abrir) {
      const codigo = abrir.dataset.abrir!;
      abierto = abierto === codigo ? null : codigo;
      aplicarAbierto();
      return;
    }
    const grande = destino.closest("button[data-grande]") as HTMLButtonElement | null;
    if (grande) {
      const color = porCodigo.get(grande.dataset.grande!);
      if (color) abrirDetalle(color, franjas.flatMap((f) => f.colores), grande, alMostrarEnAbanico);
      return;
    }
    const combinar = destino.closest("button[data-combinar]") as HTMLButtonElement | null;
    if (combinar) {
      const color = porCodigo.get(combinar.dataset.combinar!);
      if (color) elegirColorCombinador(color);
      return;
    }
    const probar = destino.closest("button[data-probar]") as HTMLButtonElement | null;
    if (probar) {
      const color = porCodigo.get(probar.dataset.probar!);
      if (color) probador.probarColores([color]);
    }
  });

  // ---------- Buscar: salta a la página del color ----------
  let autoSalto: ReturnType<typeof setTimeout> | undefined;
  function ocultarSugerencias(): void {
    sugerencias.classList.add("hidden");
    sugerencias.innerHTML = "";
  }

  function coincidencias(): ColorEnriquecido[] {
    const texto = normalizar(inputBuscar.value.trim());
    if (!texto) return [];
    const k = clave(texto);
    const peso = (c: ColorEnriquecido): number => {
      const cc = claveDe.get(c.codigo) ?? "";
      if (k && cc === k) return 0;
      if (k && cc.startsWith(k)) return 1;
      return 2;
    };
    return paleta
      .filter((c) => coincideBusqueda(c, texto, k))
      .map((c, i) => ({ c, p: peso(c), i }))
      .sort((a, b) => a.p - b.p || a.i - b.i)
      .map((x) => x.c);
  }

  /** Si lo escrito es un codigo completo (o deja un solo resultado), ese es el color buscado. */
  function resultadoClaro(): ColorEnriquecido | null {
    const k = clave(inputBuscar.value);
    if (k.length < 2) return null;
    const res = coincidencias();
    const exacto = res.find((c) => claveDe.get(c.codigo) === k);
    if (exacto) return exacto;
    return res.length === 1 ? res[0] : null;
  }

  function mostrarSugerencias(): void {
    const res = coincidencias().slice(0, 8);
    if (!res.length) {
      if (inputBuscar.value.trim()) {
        sugerencias.innerHTML = '<p class="px-4 py-3 text-sm text-tinta-500">No encontramos ese color.</p>';
        sugerencias.classList.remove("hidden");
      } else {
        ocultarSugerencias();
      }
      return;
    }
    sugerencias.innerHTML = res
      .map(
        (c) => `
        <button type="button" data-sugerido="${escapeHtml(c.codigo)}" class="flex w-full items-center gap-3 px-4 py-2.5 text-left hover:bg-crema-100">
          <span class="h-8 w-8 shrink-0 rounded-lg border border-tinta-900/10" style="background:${c.hex}"></span>
          <span class="text-sm text-tinta-900">${escapeHtml(c.nombre)} <span class="font-mono text-xs text-tinta-500">${escapeHtml(c.codigo)}</span></span>
        </button>`,
      )
      .join("");
    sugerencias.classList.remove("hidden");
  }

  function saltarA(color: ColorEnriquecido): void {
    ocultarSugerencias();
    inputBuscar.blur();
    if (!franjas.some((f) => f.prefijo === prefijoDe(color))) {
      familiaFiltro = "";
      pintarChips();
      reconstruirAbanico();
    }
    alMostrarEnAbanico(color);
    // se espera un instante para que el teclado del celular termine de cerrarse
    setTimeout(() => escenario.scrollIntoView({ behavior: "smooth", block: "center" }), 180);
  }

  sugerencias.addEventListener("click", (e) => {
    const boton = (e.target as HTMLElement).closest("button[data-sugerido]") as HTMLButtonElement | null;
    const color = boton ? porCodigo.get(boton.dataset.sugerido!) : undefined;
    if (color) saltarA(color);
  });
  document.addEventListener("click", (e) => {
    const destino = e.target as HTMLElement;
    if (destino === inputBuscar || sugerencias.contains(destino)) return;
    ocultarSugerencias();
  });
  inputBuscar.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && vista === "abanico") {
      e.preventDefault();
      clearTimeout(autoSalto);
      const elegido = resultadoClaro() ?? coincidencias()[0];
      if (elegido) saltarA(elegido);
    }
  });

  // ======================================================================
  // POR FAMILIAS: tarjetas grandes agrupadas por familia de color.
  // ======================================================================
  const GRILLA_FAMILIAS = "grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6";
  let listaFamilias: ColorEnriquecido[] = [];

  function tarjetaFamiliaHtml(c: ColorEnriquecido): string {
    return `
      <div class="paleta-celda familia-tarjeta">
        <button type="button" data-codigo="${escapeHtml(c.codigo)}" class="block w-full text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500" aria-label="${escapeHtml(c.nombre)}, ${escapeHtml(c.codigo)}">
          <div class="h-24 w-full" style="background:${c.hex}"></div>
          <div class="p-3">
            <p class="truncate text-xs font-bold text-tinta-900">${escapeHtml(c.nombre)}</p>
            <p class="mt-0.5 font-mono text-[11px] text-tinta-500">${escapeHtml(c.codigo)}</p>
          </div>
        </button>
        ${corazonHtml(c)}
      </div>`;
  }

  function repintarFamilias(): void {
    const texto = normalizar(inputBuscar.value.trim());
    const k = clave(texto);
    const filtrados = paleta.filter((c) => {
      if (familiaFiltro && c.familia !== familiaFiltro) return false;
      if (!texto) return true;
      return coincideBusqueda(c, texto, k);
    });

    contador.textContent = `${filtrados.length} colores${filtrados.length !== paleta.length ? ` de ${paleta.length}` : ""}`;
    vacio.classList.toggle("hidden", filtrados.length > 0);

    if (texto) {
      listaFamilias = filtrados;
      secciones.innerHTML = filtrados.length
        ? `<div class="${GRILLA_FAMILIAS}">${filtrados.map(tarjetaFamiliaHtml).join("")}</div>`
        : "";
      return;
    }
    const familias = familiaFiltro ? [familiaFiltro] : ORDEN_FAMILIAS;
    const grupos = familias
      .map((f) => filtrados.filter((c) => c.familia === f))
      .filter((grupo) => grupo.length > 0);
    listaFamilias = grupos.flat();
    secciones.innerHTML = grupos
      .map(
        (grupo) => `
        <div>
          <h3 class="flex items-center gap-2 font-display text-lg font-bold text-tinta-900"><i class="block h-4 w-4 rounded-full border border-tinta-900/15" style="background:${colorRepresentativo(grupo[0].familia)}"></i>${escapeHtml(ETIQUETAS_FAMILIA[grupo[0].familia])} <span class="font-sans text-sm font-normal text-tinta-500">(${grupo.length})</span></h3>
          <div class="mt-3 ${GRILLA_FAMILIAS}">${grupo.map(tarjetaFamiliaHtml).join("")}</div>
        </div>`,
      )
      .join("");
  }

  secciones.addEventListener("click", (e) => {
    const destino = e.target as HTMLElement;
    const corazon = destino.closest("button[data-apartar]") as HTMLButtonElement | null;
    if (corazon) {
      alternarApartado(corazon.dataset.apartar!);
      return;
    }
    const boton = destino.closest("button[data-codigo]") as HTMLButtonElement | null;
    if (!boton) return;
    const color = porCodigo.get(boton.dataset.codigo!);
    if (color) abrirDetalle(color, listaFamilias, boton);
  });

  // ======================================================================
  // Chips, cambio de vista y búsqueda
  // ======================================================================
  function pintarChips(): void {
    const total = `<button type="button" data-familia="" class="chip-familia" aria-pressed="${familiaFiltro === ""}">Todos</button>`;
    chips.innerHTML =
      total +
      ORDEN_FAMILIAS.map(
        (f) =>
          `<button type="button" data-familia="${f}" class="chip-familia" aria-pressed="${familiaFiltro === f}"><i style="background:${colorRepresentativo(f)}"></i>${escapeHtml(ETIQUETAS_FAMILIA[f])}</button>`,
      ).join("");
  }

  function aplicarVista(): void {
    botonesVista.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.vista === vista)));
    vistaAbanico.classList.toggle("hidden", vista !== "abanico");
    vistaFamilias.classList.toggle("hidden", vista !== "familias");
    inputBuscar.placeholder = vista === "abanico" ? "Buscá un color y saltá a su página" : "Buscá por código o nombre";
  }

  function repintar(): void {
    if (vista === "abanico") reconstruirAbanico();
    else repintarFamilias();
  }

  let debounce: ReturnType<typeof setTimeout> | undefined;
  inputBuscar.addEventListener("input", () => {
    clearTimeout(debounce);
    clearTimeout(autoSalto);
    if (vista === "abanico") {
      debounce = setTimeout(mostrarSugerencias, 80);
      // un codigo completo (o un unico resultado) salta solo, sin tener que tocar la sugerencia
      const claro = resultadoClaro();
      if (claro) {
        const k = clave(inputBuscar.value);
        autoSalto = setTimeout(() => {
          if (vista === "abanico" && clave(inputBuscar.value) === k) saltarA(claro);
        }, 450);
      }
    } else {
      debounce = setTimeout(repintarFamilias, 150);
    }
  });

  botonesVista.forEach((b) =>
    b.addEventListener("click", () => {
      vista = b.dataset.vista as Vista;
      try {
        localStorage.setItem("sc-colores-vista", vista);
      } catch {}
      inputBuscar.value = "";
      ocultarSugerencias();
      aplicarVista();
      repintar();
    }),
  );

  chips.addEventListener("click", (e) => {
    const boton = (e.target as HTMLElement).closest("button[data-familia]") as HTMLButtonElement | null;
    if (!boton) return;
    familiaFiltro = boton.dataset.familia as FamiliaColor | "";
    pintarChips();
    repintar();
  });

  function abrirDetalle(
    color: ColorEnriquecido,
    lista: ColorEnriquecido[],
    disparador?: HTMLElement,
    alMostrar?: (c: ColorEnriquecido) => void,
  ): void {
    abrirModalColor(color, {
      lista,
      paleta,
      disparador,
      alMostrar,
      alCombinar: (c) => {
        cerrarPanel();
        elegirColorCombinador(c);
      },
      alProbar: (c) => {
        cerrarPanel();
        probador.probarColores([c]);
      },
    });
  }

  // ---------- Colores apartados ----------
  const apartadosBarra = document.getElementById("apartados-barra") as HTMLElement;
  const apartadosMuestras = document.getElementById("apartados-muestras") as HTMLElement;
  const apartadosCuenta = document.getElementById("apartados-cuenta") as HTMLElement;
  const apartadosPanel = document.getElementById("apartados-panel") as HTMLElement;
  const apartadosLista = document.getElementById("apartados-lista") as HTMLElement;
  const apartadosWhatsapp = document.getElementById("apartados-whatsapp") as HTMLAnchorElement;
  const apartadosCopiar = document.getElementById("apartados-copiar") as HTMLButtonElement;
  let numeroWhatsapp = "";

  apartadosPanel.setAttribute("data-bloquea-scroll", "");

  function coloresApartados(): ColorEnriquecido[] {
    return apartados()
      .map((codigo) => porCodigo.get(codigo))
      .filter((c): c is ColorEnriquecido => !!c);
  }

  function textoSeleccion(lista: ColorEnriquecido[]): string {
    return `Hola, me interesan estos colores LANCO del abanico de Súper Color:\n${lista.map((c) => `- ${c.nombre} (${c.codigo})`).join("\n")}`;
  }

  function actualizarApartados(): void {
    const lista = coloresApartados();

    document.querySelectorAll<HTMLButtonElement>("button[data-apartar]").forEach((b) => {
      const ap = estaApartado(b.dataset.apartar!);
      b.setAttribute("aria-pressed", String(ap));
      b.title = ap ? "Quitar de mi selección" : "Apartar este color";
    });

    apartadosBarra.classList.toggle("hidden", lista.length === 0);
    apartadosBarra.classList.toggle("flex", lista.length > 0);
    apartadosCuenta.textContent = `${lista.length} color${lista.length === 1 ? "" : "es"} apartado${lista.length === 1 ? "" : "s"}`;
    apartadosMuestras.innerHTML = lista
      .slice(-5)
      .map((c) => `<span class="block h-8 w-8 rounded-full border-2 border-tinta-900" style="background:${c.hex}"></span>`)
      .join("");

    apartadosLista.innerHTML = lista.length
      ? lista
          .map(
            (c) => `
            <div class="familia-tarjeta">
              <button type="button" data-codigo="${escapeHtml(c.codigo)}" class="block w-full text-left" aria-label="${escapeHtml(c.nombre)}, ${escapeHtml(c.codigo)}">
                <div class="h-20 w-full" style="background:${c.hex}"></div>
                <div class="p-3">
                  <p class="truncate text-xs font-bold text-tinta-900">${escapeHtml(c.nombre)}</p>
                  <p class="mt-0.5 font-mono text-[11px] text-tinta-500">${escapeHtml(c.codigo)}</p>
                </div>
              </button>
              <button type="button" data-quitar="${escapeHtml(c.codigo)}" aria-label="Quitar ${escapeHtml(c.nombre)}" class="absolute right-1.5 top-1.5 grid h-7 w-7 place-items-center rounded-full bg-white/85 text-tinta-900 shadow transition-colors hover:bg-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" /></svg>
              </button>
            </div>`,
          )
          .join("")
      : '<p class="col-span-full py-10 text-center text-sm text-tinta-500">Todavía no apartaste ningún color.</p>';

    if (lista.length === 0) cerrarPanel();
    actualizarEnlaceWhatsapp(lista);
  }

  function actualizarEnlaceWhatsapp(lista: ColorEnriquecido[]): void {
    if (!numeroWhatsapp || lista.length === 0) return;
    apartadosWhatsapp.href = enlaceWhatsapp(numeroWhatsapp, textoSeleccion(lista));
    apartadosWhatsapp.target = "_blank";
    apartadosWhatsapp.rel = "noopener";
  }

  function abrirPanel(): void {
    if (coloresApartados().length === 0) return;
    apartadosPanel.classList.remove("hidden");
    apartadosPanel.classList.add("flex");
    document.body.classList.add("overflow-hidden");
  }
  function cerrarPanel(): void {
    if (apartadosPanel.classList.contains("hidden")) return;
    apartadosPanel.classList.add("hidden");
    apartadosPanel.classList.remove("flex");
    document.body.classList.remove("overflow-hidden");
  }

  document.getElementById("apartados-abrir")?.addEventListener("click", abrirPanel);
  document.getElementById("apartados-cerrar")?.addEventListener("click", cerrarPanel);
  document.getElementById("apartados-fondo")?.addEventListener("click", cerrarPanel);
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const modalColor = document.getElementById("modal-color");
    if (modalColor && !modalColor.classList.contains("hidden")) return;
    cerrarPanel();
  });

  apartadosLista.addEventListener("click", (e) => {
