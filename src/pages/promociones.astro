---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionKicker from "../components/SectionKicker.astro";
import CTABand from "../components/CTABand.astro";
---

<BaseLayout title="Promociones" description="Ofertas y descuentos vigentes en Súper Color.">
  <section class="relative overflow-hidden bg-tinta-900">
    <div class="pointer-events-none absolute -left-16 top-0 h-56 w-56 rounded-full bg-mandarina-500/30 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-16 bottom-0 h-64 w-64 rounded-full bg-fiesta-500/25 blur-3xl"></div>
    <div class="relative mx-auto max-w-4xl px-5 py-20 text-center sm:px-8 sm:py-24">
      <SectionKicker text="Ofertas vigentes" dot="bg-sol-500" light />
      <h1 class="mt-6 font-display text-4xl font-bold text-crema-50 sm:text-5xl">
        Más color por tu dinero
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-crema-100/75">
        Estas son nuestras promociones activas. Se actualizan cada mes, así que
        vuelve seguido o síguenos en redes sociales para no perderte ninguna.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div id="promociones-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
  </section>

  <CTABand
    title="¿Quieres que te avisemos de nuevas ofertas?"
    subtitle="Síguenos en redes sociales o pasa por la tienda — pronto tendrás más formas de enterarte primero."
    primaryLabel="Ver sucursales"
    primaryHref="/sucursales"
    secondaryLabel="Contáctanos"
    secondaryHref="/contacto"
  />
</BaseLayout>

<script>
  import { aFecha, fetchPromocionesVigentes, type PromocionSitio } from "../lib/content";
  import {
    degradadoPorIndice,
    escapeHtml,
    esqueletoTarjetas,
    estadoErrorHtml,
    estadoVacioHtml,
  } from "../lib/render-utils";

  const contenedor = document.getElementById("promociones-list");
  const rotaciones = ["sm:-rotate-1", "", "sm:rotate-1"];
  const formateador = new Intl.DateTimeFormat("es-HN", { day: "numeric", month: "long" });

  function detalleVigencia(p: PromocionSitio): string {
    const fin = aFecha(p.fechaFin);
    if (fin) return `Válido hasta ${formateador.format(fin)}`;
    const inicio = aFecha(p.fechaInicio);
    if (inicio) return `Vigente desde ${formateador.format(inicio)}`;
    return "Promoción vigente";
  }

  function tarjetaHtml(p: PromocionSitio, indice: number): string {
    const gradient = degradadoPorIndice(indice);
    const rotacion = rotaciones[indice % rotaciones.length];
    const imagen = p.imagenUrl
      ? `<img src="${escapeHtml(p.imagenUrl)}" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" />`
      : "";

    return `
      <article class="group relative overflow-hidden rounded-[2rem] border border-tinta-900/5 bg-crema-50 shadow-sm transition-all hover:-translate-y-1.5 hover:shadow-xl ${rotacion}">
        <div class="relative flex items-center justify-between px-6 py-5 ${gradient}">
          ${imagen}
          <span class="relative rounded-full bg-crema-50/95 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wide text-tinta-900">Promoción</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="relative h-8 w-8 text-crema-50/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L4 3l.24 5.59a2 2 0 0 0 .58 1.41l9.59 9.59a2 2 0 0 0 2.83 0l3.34-3.34a2 2 0 0 0 0-2.83Z" />
            <circle cx="7.5" cy="7.5" r="1.2" fill="currentColor" stroke="none" />
          </svg>
        </div>
        <div class="p-6">
          <h3 class="font-display text-xl font-bold text-tinta-900">${escapeHtml(p.titulo || "Promoción Súper Color")}</h3>
          <p class="mt-2 text-sm leading-relaxed text-tinta-500">${escapeHtml(p.descripcion || "")}</p>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-brand-600">${escapeHtml(detalleVigencia(p))}</p>
        </div>
      </article>`;
  }

  (async () => {
    if (!contenedor) return;
    contenedor.innerHTML = esqueletoTarjetas(3, "h-64");
    const { data, error } = await fetchPromocionesVigentes();
    if (error) {
      contenedor.innerHTML = estadoErrorHtml();
      return;
    }
    if (data.length === 0) {
      contenedor.innerHTML = estadoVacioHtml("No hay promociones activas en este momento.");
      return;
    }
    contenedor.innerHTML = data.map((p, i) => tarjetaHtml(p, i)).join("");
  })();
</script>
