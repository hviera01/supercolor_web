---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionKicker from "../components/SectionKicker.astro";
import CTABand from "../components/CTABand.astro";
---

<BaseLayout
  title="Abanico de colores"
  description="Explora el abanico de colores LANCO en forma de paleta -código, nombre y color real-, aparta tus favoritos y combínalos antes de venir a la tienda."
>
  <section class="hero-colores relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-br from-crema-200 to-crema-100"></div>
    <div class="hero-colores-dentro relative mx-auto max-w-4xl px-5 pb-3 pt-6 text-center sm:px-8 sm:pb-5 sm:pt-14">
      <SectionKicker text="Abanico digital" dot="bg-brand-500" />
      <h1 class="mt-3 font-display text-2xl font-bold text-tinta-900 sm:mt-4 sm:text-5xl">
        Elegí tu color LANCO
      </h1>
      <p class="mx-auto mt-3 hidden max-w-2xl text-base leading-relaxed text-tinta-500 sm:block sm:text-lg">
        Pasá las páginas del abanico, tocá un color para verlo en grande y
        apartá los que te gusten -al final los mandás por WhatsApp o los traés
        a tienda.
      </p>
      <div class="mt-3 flex flex-wrap justify-center gap-2 sm:mt-5">
        <a href="#probador" class="inline-flex items-center gap-1.5 rounded-full bg-tinta-900 px-4 py-1.5 text-xs font-bold text-crema-50 transition-colors hover:bg-brand-600 sm:text-sm">
          Probá los colores en una foto de tu casa
        </a>
        <a href="#foto-color" class="inline-flex items-center gap-1.5 rounded-full border border-tinta-900/10 bg-crema-50 px-4 py-1.5 text-xs font-bold text-tinta-700 transition-colors hover:border-brand-500 hover:text-brand-600 sm:text-sm">
          ¿Tenés una foto? Buscá el color desde ahí
        </a>
      </div>
    </div>
  </section>

  <!-- BARRA DE HERRAMIENTAS (se queda arriba al bajar por la paleta) -->
  <div id="colores-barra" class="border-y border-tinta-900/10 bg-crema-100">
    <div class="mx-auto max-w-7xl px-5 py-3 sm:px-8">
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="relative flex-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-tinta-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
          </svg>
          <input
            id="colores-buscar"
            type="search"
            placeholder="Buscá por código o nombre"
            class="w-full rounded-2xl border border-tinta-900/10 bg-crema-50 py-3 pl-12 pr-4 text-sm text-tinta-900 placeholder:text-tinta-500 focus:border-brand-500 focus:outline-none"
            autocomplete="off"
          />
          <div id="colores-sugerencias" class="absolute left-0 right-0 top-full z-40 mt-1 hidden max-h-72 overflow-y-auto rounded-2xl border border-tinta-900/10 bg-white shadow-lg"></div>
        </div>
        <div class="inline-flex shrink-0 rounded-2xl border border-tinta-900/10 bg-crema-50 p-1" role="group" aria-label="Tipo de vista">
          <button type="button" data-vista="abanico" aria-label="Vista de abanico" class="vista-btn flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-semibold sm:px-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4 4h5v16H4zM10.5 3h5v17h-5zM17 5h3.5v15H17z"/></svg>
            <span class="hidden sm:inline">Abanico</span>
          </button>
          <button type="button" data-vista="familias" aria-label="Vista por familias" class="vista-btn flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-semibold sm:px-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M3 4h18v3H3zM3 10.5h12v3H3zM3 17h18v3H3z"/></svg>
            <span class="hidden sm:inline">Por familias</span>
          </button>
        </div>
      </div>

      <div id="colores-chips" class="-mx-5 mt-3 flex gap-2 overflow-x-auto px-5 pb-1 sm:mx-0 sm:px-0 xl:flex-wrap xl:overflow-visible" role="group" aria-label="Filtrar por familia"></div>
      <p id="colores-contador" class="mt-2 text-xs text-tinta-500"></p>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-5 pb-28 pt-5 sm:px-8">
    <!-- ABANICO: una tira de colores por página -->
    <div id="vista-abanico">
      <div id="abanico-escenario" class="abanico-escenario">
        <button id="abanico-ant" type="button" data-nav="ant" aria-label="Página anterior" class="abanico-flecha abanico-flecha-izq">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" /></svg>
        </button>
        <div id="abanico-cartas" class="abanico-cartas"></div>
        <div class="abanico-nav">
          <button type="button" data-nav="ant" aria-label="Página anterior">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" /></svg>
            Anterior
          </button>
          <button type="button" data-nav="sig" aria-label="Página siguiente">
            Siguiente
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
        <button id="abanico-sig" type="button" data-nav="sig" aria-label="Página siguiente" class="abanico-flecha abanico-flecha-der">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>

      <div class="mx-auto mt-6 max-w-2xl">
        <p class="text-center text-sm font-semibold text-tinta-700">
          Página <span id="abanico-pagina-actual">1</span> de <span id="abanico-pagina-total">1</span>
        </p>
        <div id="abanico-espectro" class="abanico-espectro" role="slider" tabindex="0" aria-label="Saltar a otra página del abanico" aria-valuemin="1" aria-valuenow="1" aria-valuemax="1">
          <div id="abanico-barra" class="abanico-barra"></div>
          <div id="abanico-manija" class="abanico-manija"></div>
        </div>
        <p class="mt-3 text-center text-xs text-tinta-500">
          Deslizá la tira, usá los botones Anterior y Siguiente, o tocá la barra de colores para saltar rápido.
        </p>
      </div>
    </div>

    <!-- POR FAMILIAS -->
    <div id="vista-familias" class="hidden">
      <div id="colores-secciones" class="space-y-10"></div>
      <p id="colores-vacio" class="hidden rounded-2xl bg-crema-200 px-5 py-8 text-center text-sm text-tinta-600">
        No encontramos colores con esa búsqueda. Probá con otro nombre o código.
      </p>
    </div>

    <p class="mx-auto mt-10 max-w-2xl rounded-2xl border border-sol-500/40 bg-sol-300/20 px-5 py-4 text-sm leading-relaxed text-tinta-700">
      El color en tu pantalla puede variar un poco del color real de la pintura
      -cada pantalla lo muestra distinto-. Usalo para explorar y elegir
      opciones, y confirmá el tono final con el abanico físico en tienda.
    </p>
  </section>

  <!-- BARRA DE COLORES APARTADOS -->
  <div id="apartados-barra" class="pointer-events-none fixed inset-x-0 bottom-0 z-40 hidden justify-center px-3 pb-3 sm:px-6 sm:pb-5">
    <button
      id="apartados-abrir"
      type="button"
      class="pointer-events-auto flex w-full max-w-xl items-center gap-3 rounded-2xl bg-tinta-900 py-2.5 pl-3 pr-4 text-left text-crema-50 shadow-2xl transition-transform hover:-translate-y-0.5"
    >
      <span id="apartados-muestras" class="flex -space-x-2"></span>
      <span class="flex-1 text-sm font-bold"><span id="apartados-cuenta"></span></span>
      <span class="rounded-xl bg-brand-500 px-3.5 py-2 text-xs font-bold">Ver mi selección</span>
    </button>
  </div>

  <!-- PANEL DE COLORES APARTADOS -->
  <div id="apartados-panel" class="fixed inset-0 z-[55] hidden items-end justify-center sm:items-center sm:p-6">
    <div id="apartados-fondo" class="absolute inset-0 bg-tinta-900/70 backdrop-blur-sm"></div>
    <div role="dialog" aria-modal="true" aria-labelledby="apartados-titulo" class="relative z-10 flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-t-3xl bg-crema-50 shadow-2xl sm:rounded-3xl">
      <div class="flex items-start justify-between gap-3 border-b border-tinta-900/10 px-5 py-4 sm:px-6">
        <div>
          <h2 id="apartados-titulo" class="font-display text-2xl font-bold text-tinta-900">Mi selección</h2>
          <p class="text-xs text-tinta-500">Se guarda en este dispositivo para que sigas luego.</p>
        </div>
        <button id="apartados-cerrar" type="button" aria-label="Cerrar mi selección" class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-crema-200 text-tinta-900 transition-colors hover:bg-crema-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div id="apartados-lista" class="grid flex-1 grid-cols-2 gap-3 overflow-y-auto p-5 sm:grid-cols-3 sm:p-6"></div>
      <div class="flex flex-col gap-2 border-t border-tinta-900/10 bg-crema-100 px-5 py-4 sm:flex-row sm:items-center sm:px-6">
        <a id="apartados-whatsapp" href="/contacto" class="flex flex-1 items-center justify-center rounded-2xl bg-menta-500 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-menta-600">
          Enviar por WhatsApp
        </a>
        <button id="apartados-probar" type="button" class="rounded-2xl bg-tinta-900 px-5 py-3 text-sm font-bold text-crema-50 transition-colors hover:bg-brand-600">
          Probar en una foto
        </button>
        <button id="apartados-copiar" type="button" class="rounded-2xl border border-tinta-900/15 bg-crema-50 px-5 py-3 text-sm font-bold text-tinta-700 transition-colors hover:bg-crema-200">
          Copiar códigos
        </button>
        <button id="apartados-vaciar" type="button" class="rounded-2xl px-4 py-3 text-sm font-bold text-brand-600 transition-colors hover:bg-brand-50">
          Vaciar
        </button>
      </div>
    </div>
  </div>

  <!-- COMBINADOR -->
  <section id="combinador" class="bg-crema-200/60 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <SectionKicker text="Combinador" dot="bg-fiesta-500" />
      <h2 class="mt-4 font-display text-3xl font-bold text-tinta-900 sm:text-4xl">
        ¿Con qué lo combino?
      </h2>
      <p class="mt-4 text-tinta-600">
        Elegí un color, decinos para qué espacio es y qué querés lograr -o
        saltate eso- y te damos 10 opciones reales con su código para que
        las busques en el abanico físico.
      </p>

      <div class="mt-8 blob-corner border border-tinta-900/5 bg-crema-50 p-7 shadow-sm">
        <label class="block text-sm">
          <span class="font-semibold text-tinta-700">Color a combinar</span>
          <div class="relative mt-1.5">
            <input
              id="combinador-buscar"
              type="text"
              placeholder="Buscá el color de partida..."
              class="w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none"
            />
            <div id="combinador-sugerencias" class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-xl border border-tinta-900/10 bg-white shadow-lg"></div>
          </div>
        </label>
        <div id="combinador-elegido" class="mt-3 hidden items-center gap-3 rounded-xl bg-crema-100 p-3"></div>

        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="font-semibold text-tinta-700">Área (opcional)</span>
            <select id="combinador-area" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none">
              <option value="">Cualquiera</option>
            </select>
          </label>
          <label class="block text-sm">
            <span class="font-semibold text-tinta-700">¿Qué querés proyectar? (opcional)</span>
            <select id="combinador-objetivo" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none">
              <option value="">Cualquiera</option>
            </select>
          </label>
        </div>

        <button
          id="combinador-buscar-btn"
          type="button"
          disabled
          class="mt-6 w-full rounded-2xl bg-fiesta-500 py-3.5 text-sm font-bold text-crema-50 shadow-sm transition-transform enabled:hover:-translate-y-0.5 enabled:hover:bg-fiesta-600 disabled:cursor-not-allowed disabled:opacity-40 sm:w-auto sm:px-8"
        >
          Buscar combinaciones
        </button>

        <div id="combinador-vista" class="mt-7 hidden">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="font-display text-xl font-bold text-tinta-900">Así se ven juntos</h3>
            <div class="inline-flex rounded-xl border border-tinta-900/10 bg-crema-100 p-1" role="group" aria-label="Tipo de espacio">
              <button type="button" data-escena="sala" class="escena-btn rounded-lg px-3 py-1.5 text-xs font-bold">Sala</button>
              <button type="button" data-escena="fachada" class="escena-btn rounded-lg px-3 py-1.5 text-xs font-bold">Fachada</button>
            </div>
          </div>
          <div id="combinador-escena" class="combinador-escena mt-3 overflow-hidden rounded-2xl border border-tinta-900/10 bg-crema-100"></div>
          <div id="combinador-leyenda" class="mt-3 grid gap-2 sm:grid-cols-2"></div>
          <div class="mt-3 flex flex-wrap gap-2">
            <button id="combinador-invertir" type="button" class="rounded-xl border border-tinta-900/15 bg-crema-50 px-4 py-2.5 text-xs font-bold text-tinta-700 transition-colors hover:bg-crema-200">
              Invertir colores
            </button>
            <button id="combinador-probar" type="button" class="rounded-xl bg-tinta-900 px-4 py-2.5 text-xs font-bold text-crema-50 transition-colors hover:bg-brand-600">
              Probarlos en una foto real
            </button>
          </div>
          <p class="mt-4 text-xs font-semibold text-tinta-500">Tocá otra opción de abajo para verla con tu color.</p>
        </div>

        <div id="combinador-resultado" class="mt-4 hidden grid-cols-2 gap-3 sm:grid-cols-3"></div>
      </div>
    </div>
  </section>

  <!-- PROBADOR EN FOTOS REALES -->
  <section id="probador" class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <SectionKicker text="Probador" dot="bg-cielo-500" />
      <h2 class="mt-4 font-display text-3xl font-bold text-tinta-900 sm:text-4xl">
        Probalo en tu casa
      </h2>
      <p class="mt-4 max-w-2xl text-tinta-600">
        Subí una foto de tu cuarto o de tu fachada, elegí un color del abanico
        y tocá la pared. Se pinta solo esa pared, conservando la luz y las
        sombras de tu foto.
      </p>

      <div class="mt-8 blob-corner border border-tinta-900/5 bg-crema-50 p-5 shadow-sm sm:p-7">
        <div id="probador-inicio">
          <div id="probador-preparados" class="mb-4 hidden items-center gap-3 rounded-xl bg-cielo-500/10 px-4 py-3 text-sm font-semibold text-tinta-900"></div>
          <label
            for="probador-archivo"
            class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-tinta-900/15 bg-crema-100 px-6 py-10 text-center transition-colors hover:border-cielo-500 hover:bg-crema-200"
          >
            <svg class="h-9 w-9 text-cielo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 21h18M5 21V8l7-5 7 5v13" /><path d="M9 21v-6h6v6" />
            </svg>
            <span class="text-sm font-bold text-tinta-900">Tocá para subir la foto de tu casa</span>
            <span class="text-xs text-tinta-500">Podés elegir varias: un cuarto, la sala, la fachada…</span>
          </label>
          <input id="probador-archivo" type="file" accept="image/*" multiple class="sr-only" />

          <p class="mt-6 text-xs font-bold uppercase tracking-wide text-tinta-500">O probá con una foto de ejemplo</p>
          <div class="mt-2 grid grid-cols-3 gap-2 sm:gap-3">
            <button type="button" data-probador-ejemplo="fachada" class="probador-ejemplo">
              <img src="/probador/fachada-mini.jpg" alt="Fachada de una casa en Comayagua" loading="lazy" width="320" height="240" />
              <span>Fachada</span>
            </button>
            <button type="button" data-probador-ejemplo="sala" class="probador-ejemplo">
              <img src="/probador/sala-mini.jpg" alt="Sala con sillón y ventanal" loading="lazy" width="320" height="213" />
              <span>Sala</span>
            </button>
            <button type="button" data-probador-ejemplo="cuarto" class="probador-ejemplo">
              <img src="/probador/cuarto-mini.jpg" alt="Dormitorio con dos ventanas" loading="lazy" width="320" height="240" />
              <span>Dormitorio</span>
            </button>
          </div>
        </div>
        <p id="probador-error" class="mt-3 hidden rounded-xl bg-brand-50 px-4 py-3 text-sm text-brand-700"></p>

        <div id="probador-trabajo" class="hidden scroll-mt-4">
          <div id="probador-fotos" class="-mx-1 flex items-center gap-2 overflow-x-auto px-1 pb-3"></div>
          <input id="probador-archivo-mas" type="file" accept="image/*" multiple class="sr-only" />

          <p class="text-xs font-bold uppercase tracking-wide text-tinta-500">1 · Elegí el color</p>
          <div id="probador-colores" class="-mx-1 mt-2 flex gap-2 overflow-x-auto px-1 pb-1"></div>
          <div class="relative mt-2">
            <input
              id="probador-buscar"
              type="search"
              autocomplete="off"
              placeholder="Buscar otro color por nombre o código…"
              class="w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-2.5 text-sm focus:border-cielo-500 focus:outline-none"
            />
            <div id="probador-sugerencias" class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-xl border border-tinta-900/10 bg-white shadow-lg"></div>
          </div>

          <p class="mt-5 text-xs font-bold uppercase tracking-wide text-tinta-500">2 · Pintá</p>
          <div class="probador-modos mt-2" role="group" aria-label="Herramienta">
            <button type="button" data-probador-modo="pared" class="probador-modo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h12v5H4z"/><path d="M16 6.5h3v5h-8v3"/><path d="M10 14.5h2v6h-2z"/></svg>
              Pintar pared
            </button>
            <button type="button" data-probador-modo="pincel" class="probador-modo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.5 3.5a2.1 2.1 0 0 1 3 3L11 17l-4 1 1-4z"/><path d="M7 18c-1.5 0-3 1-3 3h3a2 2 0 0 0 2-2"/></svg>
              Pincel fino
            </button>
            <button type="button" data-probador-modo="borrador" class="probador-modo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 21h10"/><path d="M5.5 13.5 13 6l5 5-7.5 7.5H8z"/></svg>
              Borrador
            </button>
            <button type="button" data-probador-modo="quitar" class="probador-modo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M6 6l12 12"/></svg>
              Quitar zona
            </button>
            <button type="button" data-probador-modo="marcar" class="probador-modo probador-modo-ancho">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9c0-3 3-5 7-5s7 2 7 5-3 5-7 5c-1.5 0-3-.3-4-.8" stroke-dasharray="2.5 2.5"/><path d="M8 13.2c-1.6.9-2.5 2.1-2.5 3.3 0 1.9 1.8 3.5 4 3.5"/></svg>
              Marcar área
            </button>
          </div>
          <label id="probador-tamano-caja" class="mt-3 hidden items-center gap-3 text-xs font-bold text-tinta-700">
            <span class="shrink-0">Grosor del pincel</span>
            <input id="probador-tamano" type="range" min="4" max="60" step="1" value="18" class="w-full accent-cielo-500" />
          </label>

          <div id="probador-zona-foto" class="relative mt-3">
            <div id="probador-marco" class="probador-marco overflow-auto rounded-2xl bg-tinta-900/5">
              <div id="probador-caja" class="relative" style="width: 100%">
                <canvas id="probador-canvas" class="block w-full select-none" style="touch-action: pan-y" aria-label="Tu foto: tocá la pared que querés pintar"></canvas>
                <canvas id="probador-limite" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
                <div id="probador-marca" class="probador-marca hidden" aria-hidden="true"></div>
                <div id="probador-anillo" class="probador-anillo hidden" aria-hidden="true"></div>
