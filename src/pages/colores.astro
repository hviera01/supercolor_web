  function sugerenciaHtml(s: ReturnType<typeof combinador>[number]): string {
    return `
      <div class="combo-opcion rounded-2xl border-2 border-transparent bg-crema-100 p-3 transition-colors" data-opcion="${escapeHtml(s.color.codigo)}">
        <button type="button" data-elegir-combo="${escapeHtml(s.color.codigo)}" class="block w-full text-left" aria-label="Ver ${escapeHtml(s.color.nombre)} junto a tu color">
          <div class="flex h-16 w-full overflow-hidden rounded-lg">
            <span class="w-1/3" style="background:${colorElegido?.hex ?? s.color.hex}"></span>
            <span class="flex-1" style="background:${s.color.hex}"></span>
          </div>
          <p class="mt-2 truncate text-xs font-bold text-tinta-900">${escapeHtml(s.color.nombre)}</p>
          <p class="font-mono text-[11px] text-tinta-500">${escapeHtml(s.color.codigo)}</p>
        </button>
        <p class="mt-1.5 text-[11px] capitalize text-brand-600">${escapeHtml(s.tipo)}</p>
        <p class="mt-1 text-[11px] leading-snug text-tinta-600">${escapeHtml(s.descripcion)}</p>
        <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
          <button type="button" data-probar-combo="${escapeHtml(s.color.codigo)}" class="text-[11px] font-bold text-cielo-600 underline decoration-cielo-500/30 underline-offset-2 hover:text-cielo-700">Probar en foto</button>
          <button type="button" data-codigo="${escapeHtml(s.color.codigo)}" class="text-[11px] font-bold text-tinta-700 underline decoration-tinta-900/20 underline-offset-2 hover:text-brand-600">Ver en grande</button>
        </div>
      </div>`;
  }

  // ---------- Vista de la combinación ----------
  const comboVista = document.getElementById("combinador-vista") as HTMLElement;
  const comboEscena = document.getElementById("combinador-escena") as HTMLElement;
  const comboLeyenda = document.getElementById("combinador-leyenda") as HTMLElement;
  const botonesEscena = document.querySelectorAll<HTMLButtonElement>("[data-escena]");
  let escena: "sala" | "fachada" = "sala";
  let comboAcento: ColorEnriquecido | null = null;
  let comboInvertido = false;

  function pintarVistaCombo(): void {
    if (!colorElegido || !comboAcento) {
      comboVista.classList.add("hidden");
      return;
    }
    const principal = comboInvertido ? comboAcento : colorElegido;
    const acento = comboInvertido ? colorElegido : comboAcento;
    comboVista.classList.remove("hidden");
    botonesEscena.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.escena === escena)));
    comboEscena.innerHTML = escena === "sala" ? escenaSala(principal.hex, acento.hex) : escenaFachada(principal.hex, acento.hex);
    const fila = (c: ColorEnriquecido, rol: string) => `
      <button type="button" data-codigo="${escapeHtml(c.codigo)}" class="flex items-center gap-3 rounded-xl bg-crema-100 p-2.5 text-left transition-colors hover:bg-crema-200">
        <span class="h-9 w-9 shrink-0 rounded-lg border border-tinta-900/10" style="background:${c.hex}"></span>
        <span class="min-w-0">
          <span class="block text-[11px] font-semibold uppercase tracking-wide text-tinta-500">${rol}</span>
          <span class="block truncate text-sm font-bold text-tinta-900">${escapeHtml(c.nombre)} <span class="font-mono text-xs font-normal text-tinta-500">${escapeHtml(c.codigo)}</span></span>
        </span>
      </button>`;
    comboLeyenda.innerHTML =
      fila(principal, escena === "sala" ? "Paredes" : "Muros") + fila(acento, escena === "sala" ? "Pared de acento y detalles" : "Marcos, columnas y zócalo");
    comboResultado.querySelectorAll<HTMLElement>("[data-opcion]").forEach((el) => {
      const sel = el.dataset.opcion === comboAcento!.codigo;
      el.classList.toggle("border-tinta-900", sel);
      el.classList.toggle("border-transparent", !sel);
    });
  }

  function elegirAcento(c: ColorEnriquecido, desplazar: boolean): void {
    comboAcento = c;
    comboInvertido = false;
    pintarVistaCombo();
    if (desplazar) comboVista.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  botonesEscena.forEach((b) =>
    b.addEventListener("click", () => {
      escena = b.dataset.escena as typeof escena;
      pintarVistaCombo();
    }),
  );
  document.getElementById("combinador-invertir")?.addEventListener("click", () => {
    comboInvertido = !comboInvertido;
    pintarVistaCombo();
  });
  document.getElementById("combinador-probar")?.addEventListener("click", () => {
    if (!colorElegido || !comboAcento) return;
    probador.probarColores(comboInvertido ? [comboAcento, colorElegido] : [colorElegido, comboAcento]);
  });
  comboLeyenda.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button[data-codigo]") as HTMLButtonElement | null;
    const c = b ? porCodigo.get(b.dataset.codigo!) : undefined;
    if (c && b) abrirDetalle(c, [colorElegido!, comboAcento!].filter(Boolean), b);
  });

  comboBtn.addEventListener("click", () => {
    if (!colorElegido) return;
    const objetivo = (comboObjetivo.value || undefined) as ObjetivoCombinacion | undefined;
    const area = comboArea.value || undefined;
    const sugerencias = combinador(colorElegido, paleta, { objetivo, area });
    escena = area === "Fachada / Exterior" ? "fachada" : "sala";
    comboResultado.classList.remove("hidden");
    comboResultado.classList.add("grid");
    comboResultado.innerHTML = sugerencias.map(sugerenciaHtml).join("");
    sugerenciasActuales = sugerencias.map((x) => x.color);
    if (sugerencias.length) elegirAcento(sugerencias[0].color, false);
    else pintarVistaCombo();
  });

  let sugerenciasActuales: ColorEnriquecido[] = [];
  comboResultado.addEventListener("click", (e) => {
    const destino = e.target as HTMLElement;
    const probarCombo = destino.closest("button[data-probar-combo]") as HTMLButtonElement | null;
    if (probarCombo) {
      const c = porCodigo.get(probarCombo.dataset.probarCombo!);
      if (c && colorElegido) probador.probarColores([colorElegido, c]);
      return;
    }
    const elegir = destino.closest("button[data-elegir-combo]") as HTMLButtonElement | null;
    if (elegir) {
      const c = porCodigo.get(elegir.dataset.elegirCombo!);
      if (c) elegirAcento(c, true);
      return;
    }
    const boton = destino.closest("button[data-codigo]") as HTMLButtonElement | null;
    if (!boton) return;
    const color = porCodigo.get(boton.dataset.codigo!);
    if (color) abrirDetalle(color, sugerenciasActuales, boton);
  });

  // ---------- Colores desde una foto ----------
  const indiceFoto = indexarAbanico(paleta);
  const fotoArchivo = document.getElementById("foto-archivo") as HTMLInputElement;
  const fotoZona = document.getElementById("foto-zona") as HTMLElement;
  const fotoError = document.getElementById("foto-error") as HTMLElement;
  const fotoVisor = document.getElementById("foto-visor") as HTMLElement;
  const fotoCanvas = document.getElementById("foto-canvas") as HTMLCanvasElement;
  const fotoDominantesCaja = document.getElementById("foto-dominantes-caja") as HTMLElement;
  const fotoDominantes = document.getElementById("foto-dominantes") as HTMLElement;
  const fotoObjetivo = document.getElementById("foto-objetivo") as HTMLElement;
  const fotoLuz = document.getElementById("foto-luz") as HTMLInputElement;
  const fotoResultado = document.getElementById("foto-resultado") as HTMLElement;
  const fotoOtra = document.getElementById("foto-otra") as HTMLButtonElement;
  const fotoCtx = fotoCanvas.getContext("2d", { willReadFrequently: true })!;

  const FOTO_ANCHO_MAX = 1200;
  let fotoPixeles: ImageData | null = null;
  let fotoPunto: { x: number; y: number } | null = null;
  let fotoRgb: Rgb | null = null;
  let fotoLista: ColorEnriquecido[] = [];

  function mostrarErrorFoto(mensaje: string): void {
    fotoError.textContent = mensaje;
    fotoError.classList.remove("hidden");
  }

  async function abrirImagen(archivo: File): Promise<{ fuente: CanvasImageSource; ancho: number; alto: number }> {
    if ("createImageBitmap" in window) {
      try {
        const bm = await createImageBitmap(archivo, { imageOrientation: "from-image" });
        return { fuente: bm, ancho: bm.width, alto: bm.height };
      } catch {}
    }
    const url = URL.createObjectURL(archivo);
    try {
      const img = new Image();
      img.decoding = "async";
      img.src = url;
      await img.decode();
      return { fuente: img, ancho: img.naturalWidth, alto: img.naturalHeight };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  function dibujarFoto(): void {
    if (!fotoPixeles) return;
    fotoCtx.putImageData(fotoPixeles, 0, 0);
    if (!fotoPunto) return;
    const r = Math.max(10, Math.round(fotoCanvas.width * 0.022));
    fotoCtx.lineWidth = Math.max(3, r * 0.28);
    fotoCtx.strokeStyle = "#000000";
    fotoCtx.beginPath();
    fotoCtx.arc(fotoPunto.x, fotoPunto.y, r, 0, Math.PI * 2);
    fotoCtx.stroke();
    fotoCtx.lineWidth = Math.max(1.5, r * 0.14);
    fotoCtx.strokeStyle = "#ffffff";
    fotoCtx.beginPath();
    fotoCtx.arc(fotoPunto.x, fotoPunto.y, r, 0, Math.PI * 2);
    fotoCtx.stroke();
  }

  function pintarDominantes(lista: { rgb: Rgb; proporcion: number }[]): void {
    fotoDominantesCaja.classList.toggle("hidden", lista.length === 0);
    fotoDominantes.innerHTML = lista
      .map((c) => {
        const hex = rgbAHex(c.rgb);
        return `<button type="button" data-hex="${hex}" title="Usar este color" aria-label="Usar el color ${hex}" class="flex items-center gap-2 rounded-full border border-tinta-900/10 bg-crema-100 py-1 pl-1 pr-3 text-xs font-bold text-tinta-700 transition-colors hover:border-brand-500">
          <span class="h-7 w-7 rounded-full border border-tinta-900/10" style="background:${hex}"></span>${Math.round(c.proporcion * 100)}%
        </button>`;
      })
      .join("");
  }

  function calcularParecidos(): void {
    if (!fotoRgb) return;
    const hex = rgbAHex(fotoRgb);
    fotoObjetivo.innerHTML = `
      <span class="h-10 w-10 shrink-0 rounded-xl border border-tinta-900/10" style="background:${hex}"></span>
      <div class="flex-1">
        <p class="text-sm font-bold text-tinta-900">El color que elegiste de tu foto</p>
        <p class="font-mono text-xs text-tinta-500">${hex}</p>
      </div>`;
    const lab = ajustarLuz(rgbALab(fotoRgb), Number(fotoLuz.value));
    const parecidos = parecidosEnAbanico(indiceFoto, lab, 8);
    fotoLista = parecidos.map((p) => p.color);
    fotoResultado.innerHTML = parecidos
      .map(
        (p) => `
      <div class="rounded-2xl border border-tinta-900/5 bg-crema-100 p-3">
        <button type="button" data-codigo="${escapeHtml(p.color.codigo)}" class="block w-full text-left" aria-label="Ver ${escapeHtml(p.color.nombre)} en grande">
          <div class="h-16 w-full rounded-lg" style="background:${p.color.hex}"></div>
          <p class="mt-2 truncate text-xs font-bold text-tinta-900">${escapeHtml(p.color.nombre)}</p>
          <p class="font-mono text-[11px] text-tinta-500">${escapeHtml(p.color.codigo)}</p>
        </button>
        <p class="mt-1.5 text-[11px] text-brand-600">${etiquetaSimilitud(p.de)}</p>
      </div>`,
      )
      .join("");
  }

  function elegirPunto(x: number, y: number): void {
    if (!fotoPixeles) return;
    fotoPunto = { x, y };
    const radio = Math.max(4, Math.round(fotoCanvas.width * 0.012));
    fotoRgb = colorDeZona(fotoPixeles.data, fotoPixeles.width, fotoPixeles.height, x, y, radio);
    dibujarFoto();
    calcularParecidos();
  }

  function puntoDeEvento(e: PointerEvent | MouseEvent): { x: number; y: number } {
    const caja = fotoCanvas.getBoundingClientRect();
    return {
      x: ((e.clientX - caja.left) * fotoCanvas.width) / caja.width,
      y: ((e.clientY - caja.top) * fotoCanvas.height) / caja.height,
    };
  }

  async function cargarFoto(archivo: File): Promise<void> {
    fotoError.classList.add("hidden");
    if (!archivo.type.startsWith("image/")) {
      mostrarErrorFoto("Ese archivo no parece una foto. Probá con una imagen JPG o PNG.");
      return;
    }
    try {
      const { fuente, ancho, alto } = await abrirImagen(archivo);
      const escala = Math.min(1, FOTO_ANCHO_MAX / ancho);
      fotoCanvas.width = Math.max(1, Math.round(ancho * escala));
      fotoCanvas.height = Math.max(1, Math.round(alto * escala));
      fotoCtx.drawImage(fuente, 0, 0, fotoCanvas.width, fotoCanvas.height);
      fotoPixeles = fotoCtx.getImageData(0, 0, fotoCanvas.width, fotoCanvas.height);
      const dominantes = coloresDominantes(fotoPixeles.data, fotoPixeles.width, fotoPixeles.height, 5);
      pintarDominantes(dominantes);
      fotoZona.classList.add("hidden");
      fotoVisor.classList.remove("hidden");
      fotoLuz.value = "0";
      fotoPunto = null;
      fotoRgb = null;
      if (dominantes.length > 0) {
        fotoRgb = dominantes[0].rgb;
        calcularParecidos();
      } else {
        fotoObjetivo.innerHTML = '<p class="text-sm text-tinta-600">Tocá la foto para elegir un color.</p>';
        fotoResultado.innerHTML = "";
      }
      dibujarFoto();
    } catch {
      mostrarErrorFoto("No pudimos abrir esa foto. Probá con otra.");
    }
  }

  fotoArchivo.addEventListener("change", () => {
    const archivo = fotoArchivo.files?.[0];
    if (archivo) void cargarFoto(archivo);
  });
  fotoCanvas.addEventListener("click", (e) => {
    const p = puntoDeEvento(e);
    elegirPunto(p.x, p.y);
  });
  fotoCanvas.addEventListener("pointermove", (e) => {
    if (e.pointerType !== "mouse" || e.buttons !== 1) return;
    const p = puntoDeEvento(e);
    elegirPunto(p.x, p.y);
  });
  fotoDominantes.addEventListener("click", (e) => {
    const boton = (e.target as HTMLElement).closest("button[data-hex]") as HTMLButtonElement | null;
    if (!boton) return;
    const n = parseInt(boton.dataset.hex!.replace("#", ""), 16);
    fotoRgb = { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
    fotoPunto = null;
    dibujarFoto();
    calcularParecidos();
  });
  fotoLuz.addEventListener("input", calcularParecidos);
  fotoResultado.addEventListener("click", (e) => {
    const boton = (e.target as HTMLElement).closest("button[data-codigo]") as HTMLButtonElement | null;
    if (!boton) return;
    const color = porCodigo.get(boton.dataset.codigo!);
    if (color) abrirDetalle(color, fotoLista, boton);
  });
  fotoOtra.addEventListener("click", () => {
    fotoArchivo.value = "";
    fotoVisor.classList.add("hidden");
    fotoZona.classList.remove("hidden");
    fotoPixeles = null;
  });

  // ---------- Calculadora de rendimiento ----------
  const selectTipo = document.getElementById("rendimiento-tipo") as HTMLSelectElement;
  selectTipo.innerHTML = TIPOS_PRODUCTO.map((t) => `<option value="${t.valor}">${escapeHtml(t.etiqueta)}</option>`).join("");

  let modoArea: "dimensiones" | "lineal" | "m2" = "dimensiones";
  const botonesModo = document.querySelectorAll<HTMLButtonElement>("[data-modo-area]");
  const camposModo = document.querySelectorAll<HTMLElement>("[data-campo-area]");

  function actualizarModo(): void {
    botonesModo.forEach((b) => b.setAttribute("data-activo", String(b.dataset.modoArea === modoArea)));
    camposModo.forEach((c) => c.classList.toggle("hidden", c.dataset.campoArea !== modoArea));
  }
  botonesModo.forEach((b) =>
    b.addEventListener("click", () => {
      modoArea = b.dataset.modoArea as typeof modoArea;
      actualizarModo();
    }),
  );
  actualizarModo();

  const numero = (id: string): number => Number((document.getElementById(id) as HTMLInputElement).value) || 0;

  document.getElementById("rendimiento-calcular")?.addEventListener("click", () => {
    let areaM2 = 0;
    if (modoArea === "dimensiones") areaM2 = areaDesdeAnchoAlto(numero("rendimiento-ancho"), numero("rendimiento-alto"));
    else if (modoArea === "lineal") areaM2 = areaDesdeLineal(numero("rendimiento-lineal"), numero("rendimiento-altura-lineal"));
    else areaM2 = numero("rendimiento-m2");

    const resultadoEl = document.getElementById("rendimiento-resultado") as HTMLElement;
    if (areaM2 <= 0) {
      resultadoEl.classList.remove("hidden");
      resultadoEl.className = "mt-6 rounded-2xl bg-mandarina-50 px-5 py-4 text-sm leading-relaxed text-mandarina-600";
      resultadoEl.textContent = "Ingresá un área mayor a cero para calcular.";
      return;
    }

    const tipo = selectTipo.value as TipoProducto;
    const manos = Math.max(1, numero("rendimiento-manos"));
    const resultado = calcularPintura(areaM2, tipo, manos);
    const partes: string[] = [];
    if (resultado.compra.cubetas > 0) partes.push(`${resultado.compra.cubetas} cubeta${resultado.compra.cubetas > 1 ? "s" : ""} (5 gal)`);
    if (resultado.compra.galones > 0) partes.push(`${resultado.compra.galones} galón${resultado.compra.galones > 1 ? "es" : ""}`);
    if (resultado.compra.cuartos > 0) partes.push(`${resultado.compra.cuartos} cuarto${resultado.compra.cuartos > 1 ? "s" : ""}`);

    resultadoEl.classList.remove("hidden");
    resultadoEl.className = "mt-6 rounded-2xl bg-menta-300/15 px-5 py-4 text-sm leading-relaxed text-menta-700";
    resultadoEl.innerHTML = `
      <p class="font-bold">Área: ${resultado.areaM2.toFixed(2)} m² · Necesitás aprox. ${resultado.galonesNecesarios.toFixed(2)} galones</p>
      <p class="mt-1">Sugerencia de compra: ${partes.length ? partes.join(" + ") : "menos de un cuarto"}</p>`;
  });
</script>
