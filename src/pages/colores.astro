        <div id="foto-visor" class="hidden">
          <div class="relative overflow-hidden rounded-2xl bg-tinta-900/5">
            <canvas id="foto-canvas" class="block w-full cursor-crosshair" style="touch-action: manipulation" aria-label="Tu foto: tocá la pared que querés igualar"></canvas>
