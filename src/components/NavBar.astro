---
import BrandMark from "./BrandMark.astro";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/productos", label: "Productos" },
  { href: "/servicios", label: "Servicios" },
  { href: "/sucursales", label: "Sucursales" },
  { href: "/promociones", label: "Promociones" },
  { href: "/contacto", label: "Contacto" },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b-4 border-brand-500 bg-crema-100/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <BrandMark showTagline />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {links.map((link) => {
        const active = current === link.href;
        return (
          <a
            href={link.href}
            class={`rounded-full px-4 py-2 text-sm font-semibold transition-colors ${
              active
                ? "bg-brand-500 text-crema-50"
                : "text-tinta-700 hover:bg-brand-50 hover:text-brand-600"
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <a
      href="/contacto"
      class="hidden shrink-0 items-center gap-2 rounded-full bg-tinta-900 px-5 py-2.5 text-sm font-bold text-crema-50 shadow-sm transition-transform hover:-translate-y-0.5 hover:bg-brand-600 lg:inline-flex"
    >
      Cotizar ahora
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="grid h-11 w-11 place-items-center rounded-full border-2 border-tinta-900/10 text-tinta-900 lg:hidden"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Móvil"
    class="hidden flex-col gap-1 border-t-2 border-dashed border-brand-200 bg-crema-100 px-5 pb-5 pt-3 lg:hidden"
  >
    {links.map((link) => {
      const active = current === link.href;
      return (
        <a
          href={link.href}
          class={`rounded-xl px-4 py-3 text-base font-semibold ${
            active ? "bg-brand-500 text-crema-50" : "text-tinta-700 hover:bg-brand-50"
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <a
      href="/contacto"
      class="mt-2 rounded-xl bg-tinta-900 px-4 py-3 text-center text-base font-bold text-crema-50"
    >
      Cotizar ahora
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!!isHidden));
  });
</script>
