---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionKicker from "../components/SectionKicker.astro";
import CTABand from "../components/CTABand.astro";
---

<BaseLayout
  title="Abanico de colores"
  description="Explora digitalmente el abanico de colores LANCO -código, nombre y color real- agrupados por familia, con un combinador de ideas y una calculadora de rendimiento."
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-64 bg-gradient-to-br from-crema-200 to-crema-100"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-6 pt-16 text-center sm:px-8 sm:pt-20">
      <SectionKicker text="Abanico digital" dot="bg-brand-500" />
      <h1 class="mt-6 font-display text-4xl font-bold text-tinta-900 sm:text-5xl">
        Todos los colores LANCO, agrupados y buscables
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-tinta-500">
        Buscá por código o nombre, mirá los colores agrupados por familia, y
        usá el combinador para armar ideas antes de venir a la tienda.
      </p>
      <p class="mx-auto mt-6 max-w-2xl rounded-2xl border border-sol-500/40 bg-sol-300/20 px-5 py-4 text-sm leading-relaxed text-tinta-700">
        El color en tu pantalla puede variar un poco del color real de la
        pintura -cada pantalla lo muestra distinto-. Usalo para explorar y
        elegir opciones, y confirmá el tono final con el abanico físico en
        tienda.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 sm:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <div class="relative flex-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-tinta-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>
        <input
          id="colores-buscar"
          type="text"
          placeholder="Buscá por código o nombre (ej. OW3-1, Dove White)"
          class="w-full rounded-2xl border border-tinta-900/10 bg-crema-50 py-3.5 pl-12 pr-4 text-sm text-tinta-900 placeholder:text-tinta-500 focus:border-brand-500 focus:outline-none"
        />
      </div>
      <select
        id="colores-familia"
        class="rounded-2xl border border-tinta-900/10 bg-crema-50 py-3.5 px-4 text-sm text-tinta-900 focus:border-brand-500 focus:outline-none sm:w-64"
      >
        <option value="">Todas las familias</option>
      </select>
    </div>
    <p id="colores-contador" class="mt-3 text-xs text-tinta-500"></p>

    <div id="colores-secciones" class="mt-6 space-y-10"></div>
  </section>

  <!-- COMBINADOR -->
  <section id="combinador" class="bg-crema-200/60 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <SectionKicker text="Combinador" dot="bg-fiesta-500" />
      <h2 class="mt-4 font-display text-3xl font-bold text-tinta-900 sm:text-4xl">
        ¿Con qué lo combino?
      </h2>
      <p class="mt-4 text-tinta-600">
        Elegí un color, decinos para qué espacio es y qué querés lograr -o
        saltate eso- y te damos 10 opciones reales con su código para que
        las busques en el abanico físico.
      </p>

      <div class="mt-8 blob-corner border border-tinta-900/5 bg-crema-50 p-7 shadow-sm">
        <label class="block text-sm">
          <span class="font-semibold text-tinta-700">Color a combinar</span>
          <div class="relative mt-1.5">
            <input
              id="combinador-buscar"
              type="text"
              placeholder="Buscá el color de partida..."
              class="w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none"
            />
            <div id="combinador-sugerencias" class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-xl border border-tinta-900/10 bg-white shadow-lg"></div>
          </div>
        </label>
        <div id="combinador-elegido" class="mt-3 hidden items-center gap-3 rounded-xl bg-crema-100 p-3"></div>

        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="font-semibold text-tinta-700">Área (opcional)</span>
            <select id="combinador-area" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none">
              <option value="">Cualquiera</option>
            </select>
          </label>
          <label class="block text-sm">
            <span class="font-semibold text-tinta-700">¿Qué querés proyectar? (opcional)</span>
            <select id="combinador-objetivo" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none">
              <option value="">Cualquiera</option>
            </select>
          </label>
        </div>

        <button
          id="combinador-buscar-btn"
          type="button"
          disabled
          class="mt-6 w-full rounded-2xl bg-fiesta-500 py-3.5 text-sm font-bold text-crema-50 shadow-sm transition-transform enabled:hover:-translate-y-0.5 enabled:hover:bg-fiesta-600 disabled:cursor-not-allowed disabled:opacity-40 sm:w-auto sm:px-8"
        >
          Buscar combinaciones
        </button>

        <div id="combinador-resultado" class="mt-6 hidden grid-cols-2 gap-3 sm:grid-cols-3"></div>
      </div>
    </div>
  </section>

  <!-- CALCULADORA DE RENDIMIENTO -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <SectionKicker text="Calculadora" dot="bg-cielo-500" />
      <h2 class="mt-4 font-display text-3xl font-bold text-tinta-900 sm:text-4xl">
        ¿Cuánta pintura necesito?
      </h2>
      <p class="mt-4 text-tinta-600">
        Un estimado según el área a pintar y el tipo de producto -pedí
        confirmación en tienda para proyectos grandes.
      </p>

      <div class="mt-8 blob-corner border border-tinta-900/5 bg-crema-50 p-7 shadow-sm">
        <div class="flex flex-wrap gap-2">
          <button type="button" data-modo-area="dimensiones" class="rendimiento-modo-btn rounded-full px-4 py-2 text-sm font-semibold">Ancho × Alto</button>
          <button type="button" data-modo-area="lineal" class="rendimiento-modo-btn rounded-full px-4 py-2 text-sm font-semibold">Metros lineales</button>
          <button type="button" data-modo-area="m2" class="rendimiento-modo-btn rounded-full px-4 py-2 text-sm font-semibold">Metros cuadrados</button>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div data-campo-area="dimensiones" class="contents">
            <label class="block text-sm">
              <span class="font-semibold text-tinta-700">Ancho (m)</span>
              <input type="number" min="0" step="0.1" id="rendimiento-ancho" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none" />
            </label>
            <label class="block text-sm">
              <span class="font-semibold text-tinta-700">Alto (m)</span>
              <input type="number" min="0" step="0.1" id="rendimiento-alto" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none" />
            </label>
          </div>
          <div data-campo-area="lineal" class="contents hidden">
            <label class="block text-sm">
              <span class="font-semibold text-tinta-700">Metros lineales</span>
              <input type="number" min="0" step="0.1" id="rendimiento-lineal" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none" />
            </label>
            <label class="block text-sm">
              <span class="font-semibold text-tinta-700">Altura (m)</span>
              <input type="number" min="0" step="0.1" id="rendimiento-altura-lineal" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none" />
            </label>
          </div>
          <div data-campo-area="m2" class="contents hidden">
            <label class="block text-sm sm:col-span-2">
              <span class="font-semibold text-tinta-700">Área (m²)</span>
              <input type="number" min="0" step="0.1" id="rendimiento-m2" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none" />
            </label>
          </div>

          <label class="block text-sm">
            <span class="font-semibold text-tinta-700">Tipo de producto</span>
            <select id="rendimiento-tipo" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none"></select>
          </label>
          <label class="block text-sm">
            <span class="font-semibold text-tinta-700">Número de manos</span>
            <input type="number" min="1" step="1" value="2" id="rendimiento-manos" class="mt-1.5 w-full rounded-xl border border-tinta-900/10 bg-white px-4 py-3 text-sm focus:border-brand-500 focus:outline-none" />
          </label>
        </div>

        <button
          id="rendimiento-calcular"
          type="button"
          class="mt-6 w-full rounded-2xl bg-brand-500 py-3.5 text-sm font-bold text-crema-50 shadow-sm transition-transform hover:-translate-y-0.5 hover:bg-brand-600 sm:w-auto sm:px-8"
        >
          Calcular
        </button>

        <div id="rendimiento-resultado" class="mt-6 hidden rounded-2xl bg-menta-300/15 px-5 py-4 text-sm leading-relaxed text-menta-700"></div>
        <p class="mt-3 text-xs text-tinta-500">
          Rendimiento estimado por tipo de producto -no por producto exacto-,
          basado en referencias de LANCO donde existen y en cifras típicas de
          la industria donde no. Puede variar según la superficie y la
          técnica de aplicación.
        </p>
      </div>
    </div>
  </section>

  <CTABand
    title="¿Ya elegiste tu color?"
    subtitle="Traé el código o mostranos la pantalla, y lo preparamos frente a ti."
    primaryLabel="Escríbenos por WhatsApp"
    primaryHref="/contacto"
    primaryWhatsapp
    primaryWhatsappMensaje="Hola, quiero pedir un color del abanico"
    secondaryLabel="Ver ubicación"
    secondaryHref="/ubicacion"
  />
</BaseLayout>

<style>
  .rendimiento-modo-btn {
    color: var(--color-tinta-700);
    background: var(--color-crema-100);
  }
  .rendimiento-modo-btn[data-activo="true"] {
    background: var(--color-brand-500);
    color: var(--color-crema-50);
  }
</style>

<script>
  import datosColores from "../data/lanco_colores.json";
  import {
    enriquecerColores,
    ETIQUETAS_FAMILIA,
    ORDEN_FAMILIAS,
    combinador,
    AREAS,
    OBJETIVOS,
    type ColorLanco,
    type ColorEnriquecido,
    type FamiliaColor,
    type ObjetivoCombinacion,
  } from "../lib/color-lanco";
  import { abrirModalColor } from "../lib/color-modal";
  import { escapeHtml } from "../lib/render-utils";
  import {
    areaDesdeAnchoAlto,
    areaDesdeLineal,
    calcularPintura,
    TIPOS_PRODUCTO,
    type TipoProducto,
  } from "../lib/rendimiento";

  // ---------- Abanico de colores, agrupado por familia ----------
  const paleta: ColorEnriquecido[] = enriquecerColores(datosColores as ColorLanco[]);
  const porCodigo = new Map(paleta.map((c) => [c.codigo, c]));

  const secciones = document.getElementById("colores-secciones") as HTMLElement;
  const contador = document.getElementById("colores-contador") as HTMLElement;
  const inputBuscar = document.getElementById("colores-buscar") as HTMLInputElement;
  const selectFamilia = document.getElementById("colores-familia") as HTMLSelectElement;

  selectFamilia.innerHTML += ORDEN_FAMILIAS.map((f) => `<option value="${f}">${escapeHtml(ETIQUETAS_FAMILIA[f])}</option>`).join("");

  function normalizar(texto: string): string {
    return texto
      .toLowerCase()
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "");
  }

  function swatchHtml(c: ColorEnriquecido): string {
    return `
      <button
        type="button"
        data-codigo="${escapeHtml(c.codigo)}"
        class="group blob-corner overflow-hidden border border-tinta-900/5 bg-crema-50 text-left shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
      >
        <div class="h-20 w-full" style="background:${c.hex}"></div>
        <div class="p-3">
          <p class="truncate text-xs font-bold text-tinta-900">${escapeHtml(c.nombre)}</p>
          <p class="mt-0.5 font-mono text-[11px] text-tinta-500">${escapeHtml(c.codigo)}</p>
        </div>
      </button>`;
  }

  function seccionHtml(familia: FamiliaColor, colores: ColorEnriquecido[]): string {
    return `
      <div>
        <h3 class="font-display text-lg font-bold text-tinta-900">${escapeHtml(ETIQUETAS_FAMILIA[familia])} <span class="font-sans text-sm font-normal text-tinta-500">(${colores.length})</span></h3>
        <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
          ${colores.map(swatchHtml).join("")}
        </div>
      </div>`;
  }

  function repintar(): void {
    const texto = normalizar(inputBuscar.value.trim());
    const familiaFiltro = selectFamilia.value as FamiliaColor | "";

    const filtrados = paleta.filter((c) => {
      if (familiaFiltro && c.familia !== familiaFiltro) return false;
      if (!texto) return true;
      return normalizar(c.codigo).includes(texto) || normalizar(c.nombre).includes(texto);
    });

    contador.textContent = `${filtrados.length} colores${filtrados.length !== paleta.length ? ` de ${paleta.length}` : ""}`;

    if (texto) {
      // Buscando texto: una sola grilla plana, agrupar por familia no ayuda
      // cuando ya se sabe qué se busca.
      secciones.innerHTML = `<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">${filtrados.map(swatchHtml).join("")}</div>`;
    } else {
      const familias = familiaFiltro ? [familiaFiltro] : ORDEN_FAMILIAS;
      secciones.innerHTML = familias
        .map((f) => filtrados.filter((c) => c.familia === f))
        .filter((grupo) => grupo.length > 0)
        .map((grupo) => seccionHtml(grupo[0].familia, grupo))
        .join("");
    }
  }

  let debounce: ReturnType<typeof setTimeout> | undefined;
  inputBuscar.addEventListener("input", () => {
    clearTimeout(debounce);
    debounce = setTimeout(repintar, 150);
  });
  selectFamilia.addEventListener("change", repintar);

  secciones.addEventListener("click", (e) => {
    const boton = (e.target as HTMLElement).closest("button[data-codigo]") as HTMLButtonElement | null;
    if (!boton) return;
    const color = porCodigo.get(boton.dataset.codigo!);
    if (!color) return;
    abrirModalColor(color, elegirColorCombinador, boton);
  });

  repintar();

  // ---------- Combinador ----------
  const comboBuscar = document.getElementById("combinador-buscar") as HTMLInputElement;
  const comboSugerencias = document.getElementById("combinador-sugerencias") as HTMLElement;
  const comboElegido = document.getElementById("combinador-elegido") as HTMLElement;
  const comboArea = document.getElementById("combinador-area") as HTMLSelectElement;
  const comboObjetivo = document.getElementById("combinador-objetivo") as HTMLSelectElement;
  const comboBtn = document.getElementById("combinador-buscar-btn") as HTMLButtonElement;
  const comboResultado = document.getElementById("combinador-resultado") as HTMLElement;

  comboArea.innerHTML += AREAS.map((a) => `<option value="${escapeHtml(a)}">${escapeHtml(a)}</option>`).join("");
  comboObjetivo.innerHTML += OBJETIVOS.map((o) => `<option value="${o.valor}">${escapeHtml(o.etiqueta)}</option>`).join("");

  let colorElegido: ColorEnriquecido | null = null;

  function elegirColorCombinador(color: ColorEnriquecido): void {
    colorElegido = color;
    comboBuscar.value = "";
    comboSugerencias.classList.add("hidden");
    comboElegido.classList.remove("hidden");
    comboElegido.classList.add("flex");
    comboElegido.innerHTML = `
      <span class="h-10 w-10 shrink-0 rounded-xl border border-tinta-900/10" style="background:${color.hex}"></span>
      <div class="flex-1">
        <p class="text-sm font-bold text-tinta-900">${escapeHtml(color.nombre)}</p>
        <p class="font-mono text-xs text-tinta-500">${escapeHtml(color.codigo)}</p>
      </div>
      <button type="button" data-quitar class="text-xs font-bold text-brand-600 hover:text-brand-700">Cambiar</button>`;
    comboElegido.querySelector("[data-quitar]")?.addEventListener("click", () => {
      colorElegido = null;
      comboElegido.classList.add("hidden");
      comboElegido.classList.remove("flex");
      comboBtn.disabled = true;
    });
    comboBtn.disabled = false;
    document.getElementById("combinador")?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  comboBuscar.addEventListener("input", () => {
    const texto = normalizar(comboBuscar.value.trim());
    if (!texto) {
      comboSugerencias.classList.add("hidden");
      return;
    }
    const resultados = paleta
      .filter((c) => normalizar(c.codigo).includes(texto) || normalizar(c.nombre).includes(texto))
      .slice(0, 8);
    if (resultados.length === 0) {
      comboSugerencias.classList.add("hidden");
      return;
    }
    comboSugerencias.innerHTML = resultados
      .map(
        (c) => `
        <button type="button" data-codigo="${escapeHtml(c.codigo)}" class="flex w-full items-center gap-3 px-4 py-2.5 text-left hover:bg-crema-100">
          <span class="h-7 w-7 shrink-0 rounded-lg border border-tinta-900/10" style="background:${c.hex}"></span>
          <span class="text-sm text-tinta-900">${escapeHtml(c.nombre)} <span class="font-mono text-xs text-tinta-500">${escapeHtml(c.codigo)}</span></span>
        </button>`,
      )
      .join("");
    comboSugerencias.classList.remove("hidden");
  });
  comboSugerencias.addEventListener("click", (e) => {
    const boton = (e.target as HTMLElement).closest("button[data-codigo]") as HTMLButtonElement | null;
    if (!boton) return;
    const color = porCodigo.get(boton.dataset.codigo!);
    if (color) elegirColorCombinador(color);
  });

  function sugerenciaHtml(s: ReturnType<typeof combinador>[number]): string {
    return `
      <div class="rounded-2xl border border-tinta-900/5 bg-crema-100 p-3">
        <div class="h-16 w-full rounded-lg" style="background:${s.color.hex}"></div>
        <p class="mt-2 truncate text-xs font-bold text-tinta-900">${escapeHtml(s.color.nombre)}</p>
        <p class="font-mono text-[11px] text-tinta-500">${escapeHtml(s.color.codigo)}</p>
        <p class="mt-1.5 text-[11px] capitalize text-brand-600">${escapeHtml(s.tipo)}</p>
        <p class="mt-1 text-[11px] leading-snug text-tinta-600">${escapeHtml(s.descripcion)}</p>
      </div>`;
  }

  comboBtn.addEventListener("click", () => {
    if (!colorElegido) return;
    const objetivo = (comboObjetivo.value || undefined) as ObjetivoCombinacion | undefined;
    const area = comboArea.value || undefined;
    const sugerencias = combinador(colorElegido, paleta, { objetivo, area });
    comboResultado.classList.remove("hidden");
    comboResultado.classList.add("grid");
    comboResultado.innerHTML = sugerencias.map(sugerenciaHtml).join("");
  });

  // ---------- Calculadora de rendimiento ----------
  const selectTipo = document.getElementById("rendimiento-tipo") as HTMLSelectElement;
  selectTipo.innerHTML = TIPOS_PRODUCTO.map((t) => `<option value="${t.valor}">${escapeHtml(t.etiqueta)}</option>`).join("");

  let modoArea: "dimensiones" | "lineal" | "m2" = "dimensiones";
  const botonesModo = document.querySelectorAll<HTMLButtonElement>("[data-modo-area]");
  const camposModo = document.querySelectorAll<HTMLElement>("[data-campo-area]");

  function actualizarModo(): void {
    botonesModo.forEach((b) => b.setAttribute("data-activo", String(b.dataset.modoArea === modoArea)));
    camposModo.forEach((c) => c.classList.toggle("hidden", c.dataset.campoArea !== modoArea));
  }
  botonesModo.forEach((b) =>
    b.addEventListener("click", () => {
      modoArea = b.dataset.modoArea as typeof modoArea;
      actualizarModo();
    }),
  );
  actualizarModo();

  const numero = (id: string): number => Number((document.getElementById(id) as HTMLInputElement).value) || 0;

  document.getElementById("rendimiento-calcular")?.addEventListener("click", () => {
    let areaM2 = 0;
    if (modoArea === "dimensiones") areaM2 = areaDesdeAnchoAlto(numero("rendimiento-ancho"), numero("rendimiento-alto"));
    else if (modoArea === "lineal") areaM2 = areaDesdeLineal(numero("rendimiento-lineal"), numero("rendimiento-altura-lineal"));
    else areaM2 = numero("rendimiento-m2");

    const resultadoEl = document.getElementById("rendimiento-resultado") as HTMLElement;
    if (areaM2 <= 0) {
      resultadoEl.classList.remove("hidden");
      resultadoEl.className = "mt-6 rounded-2xl bg-mandarina-50 px-5 py-4 text-sm leading-relaxed text-mandarina-600";
      resultadoEl.textContent = "Ingresá un área mayor a cero para calcular.";
      return;
    }

    const tipo = selectTipo.value as TipoProducto;
    const manos = Math.max(1, numero("rendimiento-manos"));
    const resultado = calcularPintura(areaM2, tipo, manos);
    const partes: string[] = [];
    if (resultado.compra.cubetas > 0) partes.push(`${resultado.compra.cubetas} cubeta${resultado.compra.cubetas > 1 ? "s" : ""} (5 gal)`);
    if (resultado.compra.galones > 0) partes.push(`${resultado.compra.galones} galón${resultado.compra.galones > 1 ? "es" : ""}`);
    if (resultado.compra.cuartos > 0) partes.push(`${resultado.compra.cuartos} cuarto${resultado.compra.cuartos > 1 ? "s" : ""}`);

    resultadoEl.classList.remove("hidden");
    resultadoEl.className = "mt-6 rounded-2xl bg-menta-300/15 px-5 py-4 text-sm leading-relaxed text-menta-700";
    resultadoEl.innerHTML = `
      <p class="font-bold">Área: ${resultado.areaM2.toFixed(2)} m² · Necesitás aprox. ${resultado.galonesNecesarios.toFixed(2)} galones</p>
      <p class="mt-1">Sugerencia de compra: ${partes.length ? partes.join(" + ") : "menos de un cuarto"}</p>`;
  });
</script>
