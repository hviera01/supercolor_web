---
interface Props {
  nombre: string;
  direccion: string;
  telefono: string;
  horario: string;
  gradient: string;
}
const { nombre, direccion, telefono, horario, gradient } = Astro.props;
---

<article class="overflow-hidden rounded-3xl border border-tinta-900/5 bg-crema-50 shadow-sm">
  <div class={`relative flex h-44 items-center justify-center overflow-hidden ${gradient}`}>
    <svg class="absolute inset-0 h-full w-full opacity-20" xmlns="http://www.w3.org/2000/svg">
      <pattern id={`grid-${nombre.replace(/\s+/g, '')}`} width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" fill="none" stroke="white" stroke-width="1"></path>
      </pattern>
      <rect width="100%" height="100%" fill={`url(#grid-${nombre.replace(/\s+/g, '')})`}></rect>
    </svg>
    <svg xmlns="http://www.w3.org/2000/svg" class="relative h-14 w-14 text-crema-50 drop-shadow" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" />
    </svg>
  </div>
  <div class="p-7">
    <h3 class="font-display text-xl font-bold text-tinta-900">{nombre}</h3>
    <ul class="mt-4 space-y-2.5 text-sm text-tinta-700">
      <li class="flex gap-2.5"><span class="font-bold text-brand-500">Dirección</span> {direccion}</li>
      <li class="flex gap-2.5"><span class="font-bold text-brand-500">Teléfono</span> {telefono}</li>
      <li class="flex gap-2.5"><span class="font-bold text-brand-500">Horario</span> {horario}</li>
    </ul>
    <a
      href="/contacto"
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-600 hover:text-brand-700"
    >
      Cómo llegar
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
    </a>
  </div>
</article>
